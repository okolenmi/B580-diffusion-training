+    # cannot run at all:
+    #   AttributeError: 'NoneType' object has no attribute 'startswith'
+    #
+    # The module is `networks.lora`, not this file: this file defines only
+    # SdxlNetworkTrainer and setup_parser, and `networks/lora.py` is the one
+    # whose create_network has exactly the signature train_network calls.
+    args.network_module = "networks.lora"
+
     trainer = SdxlNetworkTrainer()
     trainer.train(args)
