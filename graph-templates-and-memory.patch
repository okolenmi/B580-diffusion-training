diff --git a/backend/infrastructure/persistence/migrations/009_templates.sql b/backend/infrastructure/persistence/migrations/009_templates.sql
new file mode 100644
index 0000000..34d7515
--- /dev/null
+++ b/backend/infrastructure/persistence/migrations/009_templates.sql
@@ -0,0 +1,15 @@
+-- Templates: saved pages (a board of blocks + a snapshot of the graph they
+-- belong to), and monitor windows (a board of live views). The whole
+-- document is one JSON column, stored verbatim like saved_graphs.graph:
+-- the layout vocabulary is the frontend's to grow, and a column per block
+-- field would make every addition a migration. `kind` is a real column
+-- only so a list can be filtered without decoding every document.
+CREATE TABLE IF NOT EXISTS templates (
+    name        TEXT PRIMARY KEY,
+    description TEXT NOT NULL DEFAULT '',
+    kind        TEXT NOT NULL DEFAULT 'template',
+    doc         TEXT NOT NULL,
+    created_at  TEXT NOT NULL,
+    updated_at  TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_templates_updated ON templates (updated_at DESC);
diff --git a/backend/infrastructure/persistence/template_library.py b/backend/infrastructure/persistence/template_library.py
new file mode 100644
index 0000000..40216cc
--- /dev/null
+++ b/backend/infrastructure/persistence/template_library.py
@@ -0,0 +1,84 @@
+"""SqliteTemplateLibrary -- the TemplateLibrary port over ``templates``.
+
+Same upsert shape as ``SqliteGraphLibrary`` (``INSERT OR IGNORE`` then
+``UPDATE``, so two tabs saving one name cannot race and ``created`` falls
+out of the insert's rowcount). The stored document is returned exactly as
+written.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime
+
+from ...application.ports.template_library import SavedTemplate, TemplateLibrary
+from .sqlite import SqliteDatabase
+
+_COLUMNS = "name, description, kind, doc, created_at, updated_at"
+
+
+def _row_to_saved(row) -> SavedTemplate:
+    return SavedTemplate(
+        name=row["name"],
+        description=row["description"],
+        kind=row["kind"],
+        doc=json.loads(row["doc"]),
+        created_at=datetime.fromisoformat(row["created_at"]),
+        updated_at=datetime.fromisoformat(row["updated_at"]),
+    )
+
+
+class SqliteTemplateLibrary(TemplateLibrary):
+    def __init__(self, db: SqliteDatabase) -> None:
+        self._db = db
+
+    def save(
+        self, name: str, doc: dict, *, kind: str, description: str = ""
+    ) -> tuple[SavedTemplate, bool]:
+        now = datetime.now().isoformat()
+        payload = json.dumps(doc)
+        with self._db.connection() as conn:
+            cursor = conn.execute(
+                "INSERT OR IGNORE INTO templates "
+                "(name, description, kind, doc, created_at, updated_at) "
+                "VALUES (?, ?, ?, ?, ?, ?)",
+                (name, description, kind, payload, now, now),
+            )
+            created = cursor.rowcount > 0
+            if not created:
+                conn.execute(
+                    "UPDATE templates SET description = ?, kind = ?, doc = ?, "
+                    "updated_at = ? WHERE name = ?",
+                    (description, kind, payload, now, name),
+                )
+            row = conn.execute(
+                f"SELECT {_COLUMNS} FROM templates WHERE name = ?", (name,)
+            ).fetchone()
+        return _row_to_saved(row), created
+
+    def get(self, name: str) -> SavedTemplate | None:
+        with self._db.connection() as conn:
+            row = conn.execute(
+                f"SELECT {_COLUMNS} FROM templates WHERE name = ?", (name,)
+            ).fetchone()
+        return _row_to_saved(row) if row else None
+
+    def list_templates(self, kind: str | None = None) -> tuple[SavedTemplate, ...]:
+        with self._db.connection() as conn:
+            if kind is None:
+                rows = conn.execute(
+                    f"SELECT {_COLUMNS} FROM templates "
+                    "ORDER BY updated_at DESC, name ASC"
+                ).fetchall()
+            else:
+                rows = conn.execute(
+                    f"SELECT {_COLUMNS} FROM templates WHERE kind = ? "
+                    "ORDER BY updated_at DESC, name ASC",
+                    (kind,),
+                ).fetchall()
+        return tuple(_row_to_saved(row) for row in rows)
+
+    def delete(self, name: str) -> bool:
+        with self._db.connection() as conn:
+            cursor = conn.execute("DELETE FROM templates WHERE name = ?", (name,))
+        return cursor.rowcount > 0
