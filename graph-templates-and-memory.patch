diff --git a/frontend/tests/board_layout.test.mjs b/frontend/tests/board_layout.test.mjs
new file mode 100644
index 0000000..fcf017f
--- /dev/null
+++ b/frontend/tests/board_layout.test.mjs
@@ -0,0 +1,171 @@
+/* Unit tests for board/layout.js -- the grid arithmetic. Pure, so every rule
+   here is checked by number, not by looking at a page.
+   Run: node --test frontend/tests */
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  addAt, cellDelta, clamp, collides, columnWidth, effH, findFreeSlot, flowOrder,
+  keyNudge, moveTo, resizeTo, resolve, setCollapsed, totalRows,
+} from "../js/board/layout.js";
+
+const C = 12;
+const b = (id, x, y, w, h, extra = {}) => ({ id, x, y, w, h, ...extra });
+const by = (blocks, id) => blocks.find((q) => q.id === id);
+function assertNoOverlap(blocks) {
+  for (let i = 0; i < blocks.length; i++)
+    for (let j = i + 1; j < blocks.length; j++)
+      assert.ok(!collides(blocks[i], blocks[j]), `${blocks[i].id} overlaps ${blocks[j].id}`);
+}
+
+test("touching edges are not a collision; overlap is", () => {
+  assert.ok(!collides(b("a", 0, 0, 6, 2), b("b", 6, 0, 6, 2)));
+  assert.ok(!collides(b("a", 0, 0, 6, 2), b("b", 0, 2, 6, 2)));
+  assert.ok(collides(b("a", 0, 0, 6, 2), b("b", 5, 1, 6, 2)));
+});
+
+test("a collapsed block is one row but keeps its stored height", () => {
+  const x = b("a", 0, 0, 6, 5, { collapsed: true });
+  assert.equal(effH(x), 1);
+  assert.equal(x.h, 5);
+  assert.ok(!collides(x, b("c", 0, 1, 6, 2)), "the row it gave up is usable");
+});
+
+test("clamp: integer, inside the grid, never below 1 cell; garbage does not throw", () => {
+  assert.deepEqual(clamp(b("a", 10.4, -3, 6, 0), C), b("a", 6, 0, 6, 1));
+  assert.deepEqual(clamp(b("a", 0, 0, 99, 2), C), b("a", 0, 0, 12, 2));
+  const weird = clamp({ id: "z", x: NaN, y: undefined, w: "x", h: null }, C);
+  assert.ok([weird.x, weird.y, weird.w, weird.h].every(Number.isInteger));
+});
+
+test("resolve: settles upward -- holes close, order is kept", () => {
+  const out = resolve([b("a", 0, 5, 12, 2), b("b", 0, 9, 12, 2)], C);
+  assert.equal(by(out, "a").y, 0);
+  assert.equal(by(out, "b").y, 2);
+});
+
+test("resolve: side-by-side blocks both stay on row 0", () => {
+  const out = resolve([b("a", 0, 3, 6, 2), b("b", 6, 7, 6, 2)], C);
+  assert.equal(by(out, "a").y, 0);
+  assert.equal(by(out, "b").y, 0);
+});
+
+test("resolve: overlapping input is separated, nothing overlaps afterwards", () => {
+  const out = resolve([b("a", 0, 0, 8, 3), b("b", 2, 1, 8, 3), b("c", 4, 2, 8, 3)], C);
+  assertNoOverlap(out);
+});
+
+test("resolve is deterministic and idempotent", () => {
+  const input = [b("c", 3, 0, 6, 2), b("a", 0, 0, 6, 2), b("b", 0, 0, 6, 2)];
+  const once = resolve(input, C);
+  assert.deepEqual(resolve(input, C), once);
+  assert.deepEqual(resolve(once, C), once);
+});
+
+test("resolve keeps the input's order of blocks (callers index into it)", () => {
+  const input = [b("z", 0, 4, 6, 1), b("a", 0, 0, 6, 1)];
+  assert.deepEqual(resolve(input, C).map((q) => q.id), ["z", "a"]);
+});
+
+test("moveTo: the held block lands where it was dropped; others make way below", () => {
+  const start = resolve([b("a", 0, 0, 6, 2), b("b", 6, 0, 6, 2), b("c", 0, 2, 12, 2)], C);
+  const out = moveTo(start, "c", 0, 0, C);
+  assert.equal(by(out, "c").y, 0);
+  assert.equal(by(out, "a").y, 4 - 2 + 0, "a pushed under c (c is 2 rows)");
+  assertNoOverlap(out);
+});
+
+test("moveTo clamps to the grid: cannot be dragged off the right edge or above the top", () => {
+  const start = [b("a", 0, 0, 6, 2)];
+  const out = moveTo(start, "a", 50, -4, C);
+  assert.equal(by(out, "a").x, 6);
+  assert.equal(by(out, "a").y, 0);
+});
+
+test("resizeTo: growing pushes the neighbour below; shrinking lets it come back up", () => {
+  const start = resolve([b("a", 0, 0, 12, 2), b("b", 0, 2, 12, 2)], C);
+  const grown = resizeTo(start, "a", 12, 5, C);
+  assert.equal(by(grown, "b").y, 5);
+  const shrunk = resolve(resizeTo(grown, "a", 12, 2, C), C);
+  assert.equal(by(shrunk, "b").y, 2);
+});
+
+test("resizeTo clamps width to the grid and height to at least one row", () => {
+  const out = resizeTo([b("a", 4, 0, 4, 2)], "a", 40, 0, C);
+  assert.equal(by(out, "a").w, 12);
+  assert.equal(by(out, "a").x, 0, "a block that cannot fit where it is moves left");
+  assert.equal(by(out, "a").h, 1);
+});
+
+test("collapsing frees the rows under the header, expanding takes them back", () => {
+  const start = resolve([b("a", 0, 0, 12, 4), b("b", 0, 4, 12, 2)], C);
+  const folded = setCollapsed(start, "a", true, C);
+  assert.equal(by(folded, "b").y, 1);
+  assert.equal(by(folded, "a").h, 4, "stored height survives");
+  const open = setCollapsed(folded, "a", false, C);
+  assert.equal(by(open, "b").y, 4);
+});
+
+test("findFreeSlot: fills a gap before using the bottom", () => {
+  const blocks = [b("a", 0, 0, 6, 2), b("b", 0, 2, 12, 2)];
+  assert.deepEqual(findFreeSlot(blocks, 6, 2, C), { x: 6, y: 0 });
+  assert.deepEqual(findFreeSlot(blocks, 8, 2, C), { x: 0, y: 4 });
+});
+
+test("findFreeSlot on an empty page is the origin", () => {
+  assert.deepEqual(findFreeSlot([], 6, 3, C), { x: 0, y: 0 });
+});
+
+test("addAt places, keeps existing blocks, never overlaps", () => {
+  let blocks = [];
+  for (let i = 0; i < 9; i++) blocks = addAt(blocks, b(`n${i}`, 0, 0, 5, 3), C);
+  assert.equal(blocks.length, 9);
+  assertNoOverlap(blocks);
+  assert.ok(blocks.every((q) => q.x + q.w <= C));
+});
+
+test("flowOrder is reading order (y, x, id)", () => {
+  const order = flowOrder([b("c", 6, 2, 6, 1), b("a", 0, 0, 6, 1), b("b", 6, 0, 6, 1)]).map((q) => q.id);
+  assert.deepEqual(order, ["a", "b", "c"]);
+});
+
+test("totalRows counts collapsed blocks as one row", () => {
+  assert.equal(totalRows([b("a", 0, 0, 12, 6, { collapsed: true }), b("b", 0, 1, 12, 2)]), 3);
+});
+
+test("cellDelta and columnWidth: pixels to cells", () => {
+  const colW = columnWidth(1180, 12, 8); // (1180 - 88) / 12 = 91
+  assert.equal(colW, 91);
+  assert.deepEqual(cellDelta(99 * 2 + 10, -40, colW, 40, 8), { dCols: 2, dRows: -1 });
+  assert.deepEqual(cellDelta(10, 10, colW, 40, 8), { dCols: 0, dRows: 0 });
+});
+
+test("keyNudge: arrows move one cell, shift+arrows resize, other keys do nothing", () => {
+  const start = resolve([b("a", 2, 2, 4, 2)], C);
+  assert.equal(by(keyNudge(start, "a", "ArrowRight", false, C), "a").x, 3);
+  assert.equal(by(keyNudge(start, "a", "ArrowDown", true, C), "a").h, 3);
+  assert.equal(by(keyNudge(start, "a", "ArrowLeft", true, C), "a").w, 3);
+  assert.equal(keyNudge(start, "a", "x", false, C), start);
+  assert.equal(keyNudge(start, "missing", "ArrowUp", false, C), start);
+});
+
+test("a randomized stress: any sequence of moves and resizes stays valid", () => {
+  let seed = 7;
+  const rnd = (n) => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed % n; };
+  let blocks = [];
+  for (let i = 0; i < 12; i++) blocks = addAt(blocks, b(`n${i}`, 0, 0, 1 + rnd(8), 1 + rnd(4)), C);
+  for (let step = 0; step < 300; step++) {
+    const id = `n${rnd(12)}`;
+    blocks = rnd(3) === 0
+      ? resizeTo(blocks, id, 1 + rnd(14), 1 + rnd(6), C)
+      : rnd(2) === 0
+        ? moveTo(blocks, id, rnd(14) - 1, rnd(20) - 2, C)
+        : setCollapsed(blocks, id, rnd(2) === 0, C);
+    assertNoOverlap(blocks);
+    for (const q of blocks) {
+      assert.ok(q.x >= 0 && q.y >= 0 && q.w >= 1 && q.h >= 1 && q.x + q.w <= C, `bad block ${JSON.stringify(q)}`);
+    }
+  }
+  assert.deepEqual(resolve(resolve(blocks, C), C), resolve(blocks, C), "settled layouts are stable");
+});
diff --git a/frontend/tests/board_live.test.mjs b/frontend/tests/board_live.test.mjs
new file mode 100644
index 0000000..2226cab
--- /dev/null
+++ b/frontend/tests/board_live.test.mjs
@@ -0,0 +1,63 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { LiveStreams } from "../js/board/live.js";
+
+function fake() {
+  const opened = [];
+  const open = (id, handlers) => {
+    const src = { id, handlers, closed: false, close() { this.closed = true; } };
+    opened.push(src);
+    return src;
+  };
+  return { opened, live: new LiveStreams({ open, now: () => 1234 }) };
+}
+const msg = (src, obj) => src.handlers.onMessage({ data: JSON.stringify(obj) });
+
+test("one connection per stream however many blocks watch it; closes with the last", () => {
+  const { opened, live } = fake();
+  const a = live.acquire("node:t", () => {});
+  const b = live.acquire("node:t", () => {});
+  live.acquire("graph:run", () => {});
+  assert.equal(opened.length, 2);
+  assert.strictEqual(a.state, b.state);
+  a.release(); a.release();                       // releasing twice is harmless
+  assert.equal(opened[0].closed, false);
+  b.release();
+  assert.equal(opened[0].closed, true);
+  assert.deepEqual(live.openIds, ["graph:run"]);
+});
+
+test("frames reach every listener; ignored frames do not; errors mark disconnected", () => {
+  const { opened, live } = fake();
+  let n1 = 0, n2 = 0;
+  const a = live.acquire("s", () => n1++);
+  live.acquire("s", () => n2++);
+  const src = opened[0];
+  msg(src, { type: "connected" });
+  msg(src, { step: 1, loss: 2 });
+  msg(src, { type: "mystery" });
+  assert.deepEqual([n1, n2], [2, 2]);
+  assert.equal(a.state.rows.length, 1);
+  assert.equal(a.state.rows[0].at, 1234);
+  src.handlers.onError();
+  assert.equal(a.state.conn, "disconnected");
+  assert.equal(n1, 3);
+});
+
+test("re-acquiring after the last release starts a fresh, empty stream", () => {
+  const { opened, live } = fake();
+  const a = live.acquire("s", () => {});
+  msg(opened[0], { step: 1, loss: 2 });
+  a.release();
+  const b = live.acquire("s", () => {});
+  assert.equal(opened.length, 2);
+  assert.equal(b.state.rows.length, 0);
+});
+
+test("closeAll closes everything", () => {
+  const { opened, live } = fake();
+  live.acquire("a", () => {}); live.acquire("b", () => {});
+  live.closeAll();
+  assert.ok(opened.every((s) => s.closed));
+  assert.deepEqual(live.openIds, []);
+});
diff --git a/frontend/tests/board_model.test.mjs b/frontend/tests/board_model.test.mjs
new file mode 100644
index 0000000..e2ffd4c
--- /dev/null
+++ b/frontend/tests/board_model.test.mjs
@@ -0,0 +1,226 @@
+/* Unit tests for board/model.js -- the document rules. Pure; no DOM. */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  addBlock, autoFill, buildAvailable, defaultSize, docKey, emptyDoc, findTarget,
+  getFieldValue, graphRef, layoutKey, newBlockId, nodeRef, refKey, removeBlock,
+  setFieldValue, statusByBlock, titleFor, toSaveDoc, valuesPayload,
+} from "../js/board/model.js";
+import { collides } from "../js/board/layout.js";
+
+const field = (name, extra = {}) => ({
+  name, type: "int", required: false, default: null, wired: false, advanced: false,
+  has_value: false, label: "", ...extra,
+});
+const modules = () => ({
+  nodes: [
+    {
+      id: "n1", class_name: "Trainer", display_name: "Trainer", known: true, stream: "node:n1",
+      fields: [
+        field("steps", { has_value: true, value: 100, label: "Steps" }),
+        field("lr", { type: "float", has_value: true }),
+        field("seed", {}),                                   // unset, optional: not auto-exposed
+        field("model", { type: "str", required: true }),     // required, no default: exposed
+        field("rank_x", { advanced: true, has_value: true }), // advanced: not auto-exposed
+        field("fed", { wired: true, has_value: true }),       // wired: never
+        field("flag", { type: "bool", has_value: true }),
+      ],
+      displays: [
+        { name: "loss", title: "Loss", kind: "chart", size: [8, 4] },
+        { name: "progress", title: "Progress", kind: "progress", size: [12, 2] },
+      ],
+    },
+    { id: "gone", class_name: "Missing", display_name: "Missing", known: false, fields: [], displays: [] },
+  ],
+  graph_fields: [
+    { name: "memory.vram_max_mb", label: "VRAM budget", type: "float" },
+    { name: "memory.strict", label: "Strict", type: "bool", advanced: true },
+  ],
+  graph_displays: [
+    { name: "run", title: "Run status", size: [6, 3] },
+    { name: "memory", title: "Device memory", size: [12, 5] },
+  ],
+});
+const graph = () => ({
+  nodes: [{ id: "n1", class_name: "Trainer", params: { steps: 100, lr: 0.0001 } }],
+  edges: [], memory: { vram_max_mb: "auto" },
+});
+
+test("refKey distinguishes node, graph, field and display targets", () => {
+  const keys = new Set([
+    refKey(nodeRef("n1", "field", "x")), refKey(nodeRef("n1", "display", "x")),
+    refKey(nodeRef("n2", "field", "x")), refKey(graphRef("field", "x")),
+    refKey(graphRef("display", "x")),
+  ]);
+  assert.equal(keys.size, 5);
+});
+
+test("newBlockId never reuses an id, even after removals", () => {
+  const blocks = [{ id: "b1" }, { id: "b3" }];
+  assert.equal(newBlockId(blocks), "b3" === "b3" && !blocks.some((b) => b.id === "b3") ? "b3" : "b4");
+  assert.ok(!blocks.some((b) => b.id === newBlockId(blocks)));
+  assert.match(newBlockId([]), /^[A-Za-z0-9_-]{1,40}$/);
+});
+
+test("findTarget: present, missing node, missing module, graph scope", () => {
+  const m = modules();
+  assert.equal(findTarget(nodeRef("n1", "field", "steps"), m).descriptor.name, "steps");
+  assert.equal(findTarget(nodeRef("zz", "field", "steps"), m).node, null);
+  assert.equal(findTarget(nodeRef("n1", "field", "nope"), m).descriptor, null);
+  assert.equal(findTarget(nodeRef("n1", "display", "loss"), m).descriptor.kind, "chart");
+  assert.equal(findTarget(graphRef("display", "memory"), m).descriptor.title, "Device memory");
+  assert.equal(findTarget(graphRef("field", "memory.nope"), m).descriptor, null);
+  assert.deepEqual(findTarget(graphRef("field", "x"), null), { node: null, descriptor: null });
+});
+
+test("titleFor: custom title wins; orphan falls back to the saved name", () => {
+  const m = modules();
+  const b = { ref: nodeRef("n1", "field", "steps"), title: null };
+  assert.equal(titleFor(b, m).title, "Steps");
+  assert.equal(titleFor({ ...b, title: "Training length" }, m).title, "Training length");
+  assert.equal(titleFor({ ref: nodeRef("zz", "field", "q"), title: null }, m).title, "q");
+  assert.equal(titleFor({ ref: graphRef("field", "memory.vram_max_mb"), title: null }, m).subtitle, "Graph");
+});
+
+test("defaultSize: a field is two rows, json three, display from its module, narrow = full width", () => {
+  const m = modules();
+  assert.deepEqual(defaultSize(nodeRef("n1", "field", "flag"), m, 12), [4, 2]);
+  assert.deepEqual(defaultSize({ ...nodeRef("n1", "field", "steps") }, m, 12), [4, 2]);
+  assert.deepEqual(defaultSize(nodeRef("n1", "display", "loss"), m, 12), [8, 4]);
+  assert.deepEqual(defaultSize(nodeRef("n1", "display", "loss"), m, 6), [6, 4]);
+  assert.deepEqual(defaultSize(nodeRef("n1", "display", "loss"), m, 4), [4, 4]);
+  assert.deepEqual(defaultSize(nodeRef("zz", "display", "q"), m, 12), [6, 4]);
+});
+
+test("tray: wired fields and unknown classes are never offered; advanced only on request", () => {
+  const m = modules();
+  const tray = buildAvailable(m, []);
+  const all = tray.flatMap((g) => g.items.map((i) => i.key));
+  assert.ok(!all.includes("node/n1/field/fed"), "wired field offered");
+  assert.ok(!all.some((k) => k.startsWith("node/gone/")));
+  assert.ok(!all.includes("node/n1/field/rank_x"), "advanced shown by default");
+  assert.ok(!all.includes("graph/field/memory.strict"));
+  const adv = buildAvailable(m, [], { showAdvanced: true }).flatMap((g) => g.items.map((i) => i.key));
+  assert.ok(adv.includes("node/n1/field/rank_x") && adv.includes("graph/field/memory.strict"));
+  assert.equal(tray[0].key, "graph", "graph group first");
+});
+
+test("tray: placed items are flagged, and an advanced placed item stays findable", () => {
+  const m = modules();
+  const blocks = [{ id: "b1", ref: nodeRef("n1", "field", "rank_x") }];
+  const items = buildAvailable(m, blocks).find((g) => g.key === "node:n1").items;
+  const it = items.find((i) => i.key === "node/n1/field/rank_x");
+  assert.ok(it && it.placed);
+  assert.ok(items.filter((i) => i.key !== it.key).every((i) => !i.placed));
+});
+
+test("addBlock: lands without overlap, twice is a no-op, remove closes the gap", () => {
+  const m = modules();
+  let doc = emptyDoc("template", graph());
+  doc = addBlock(doc, nodeRef("n1", "field", "steps"), m);
+  doc = addBlock(doc, nodeRef("n1", "display", "loss"), m);
+  doc = addBlock(doc, nodeRef("n1", "field", "lr"), m);
+  assert.equal(doc.blocks.length, 3);
+  const again = addBlock(doc, nodeRef("n1", "field", "steps"), m);
+  assert.equal(again, doc);
+  for (let i = 0; i < 3; i++) for (let j = i + 1; j < 3; j++)
+    assert.ok(!collides(doc.blocks[i], doc.blocks[j]));
+  assert.equal(new Set(doc.blocks.map((b) => b.id)).size, 3);
+  const removed = removeBlock(doc, doc.blocks[0].id);
+  assert.equal(removed.blocks.length, 2);
+});
+
+test("autoFill exposes what the author set / what is required, never wired or advanced", () => {
+  const doc = autoFill(modules(), 12);
+  const keys = doc.map((b) => refKey(b.ref));
+  for (const want of [
+    "graph/field/memory.vram_max_mb", "node/n1/field/steps", "node/n1/field/lr",
+    "node/n1/field/model", "node/n1/field/flag",
+    "node/n1/display/loss", "node/n1/display/progress", "graph/display/run", "graph/display/memory",
+  ]) assert.ok(keys.includes(want), `missing ${want}`);
+  for (const bad of ["node/n1/field/seed", "node/n1/field/rank_x", "node/n1/field/fed"])
+    assert.ok(!keys.includes(bad), `should not expose ${bad}`);
+});
+
+test("autoFill: no overlap, inside the grid, fields left / displays right, ids unique", () => {
+  for (const columns of [12, 6, 4, 24]) {
+    const blocks = autoFill(modules(), columns);
+    for (const b of blocks) {
+      assert.ok(b.x >= 0 && b.x + b.w <= columns, `${b.id} off grid at ${columns}`);
+      assert.ok(Number.isInteger(b.y) && b.y >= 0);
+    }
+    for (let i = 0; i < blocks.length; i++) for (let j = i + 1; j < blocks.length; j++)
+      assert.ok(!collides(blocks[i], blocks[j]), `${blocks[i].id}/${blocks[j].id} @${columns}`);
+    assert.equal(new Set(blocks.map((b) => b.id)).size, blocks.length);
+  }
+  const wide = autoFill(modules(), 12);
+  const leftmost = Math.min(...wide.filter((b) => b.ref.kind === "display").map((b) => b.x));
+  const fieldRight = Math.max(...wide.filter((b) => b.ref.kind === "field").map((b) => b.x + b.w));
+  assert.ok(leftmost >= fieldRight, "displays overlap the field column");
+});
+
+test("autoFill honours maxFields and copes with an empty graph", () => {
+  const m = modules();
+  m.nodes[0].fields = Array.from({ length: 40 }, (_, i) => field(`f${i}`, { has_value: true }));
+  const nodeFields = autoFill(m, 12, { maxFields: 5 }).filter((b) => b.ref.scope === "node" && b.ref.kind === "field");
+  assert.equal(nodeFields.length, 5);
+  const empty = autoFill({ nodes: [], graph_fields: [], graph_displays: [] }, 12);
+  assert.deepEqual(empty.map((b) => refKey(b.ref)), ["graph/display/run"]);
+});
+
+test("field values live in the draft graph; clearing deletes the key", () => {
+  const doc = { ...emptyDoc("template", graph()) };
+  const steps = nodeRef("n1", "field", "steps");
+  assert.equal(getFieldValue(doc, steps), 100);
+  assert.equal(setFieldValue(doc, steps, 250), true);
+  assert.equal(doc.graph.nodes[0].params.steps, 250);
+  assert.equal(setFieldValue(doc, steps, 250), false, "same value is not a change");
+  assert.equal(setFieldValue(doc, steps, ""), true);
+  assert.ok(!("steps" in doc.graph.nodes[0].params));
+  assert.equal(getFieldValue(doc, steps), undefined);
+  const vram = graphRef("field", "memory.vram_max_mb");
+  assert.equal(getFieldValue(doc, vram), "auto");
+  setFieldValue(doc, vram, 9000);
+  assert.equal(doc.graph.memory.vram_max_mb, 9000);
+  setFieldValue(doc, vram, null);
+  assert.ok(!("vram_max_mb" in doc.graph.memory));
+  assert.equal(setFieldValue(doc, nodeRef("nope", "field", "x"), 1), false);
+});
+
+test("valuesPayload: exposed fields only; cleared => null; unset memory omitted; refused statuses skipped", () => {
+  const m = modules();
+  let doc = emptyDoc("template", graph());
+  doc = addBlock(doc, nodeRef("n1", "field", "steps"), m);
+  doc = addBlock(doc, nodeRef("n1", "field", "seed"), m);   // exposed but unset
+  doc = addBlock(doc, graphRef("field", "memory.vram_max_mb"), m);
+  doc = addBlock(doc, graphRef("field", "memory.strict"), m); // unset memory key
+  doc = addBlock(doc, nodeRef("n1", "display", "loss"), m);   // not a field
+  assert.deepEqual(valuesPayload(doc), {
+    nodes: { n1: { steps: 100, seed: null } }, memory: { vram_max_mb: "auto" },
+  });
+  const wiredBlock = doc.blocks.find((b) => b.ref.name === "seed");
+  assert.deepEqual(valuesPayload(doc, { [wiredBlock.id]: "wired" }).nodes, { n1: { steps: 100 } });
+  assert.deepEqual(valuesPayload(emptyDoc("monitor")), {});
+});
+
+test("dirty keys: layout changes layoutKey, a value changes only graphKey, live data neither", () => {
+  const m = modules();
+  let doc = addBlock(emptyDoc("template", graph()), nodeRef("n1", "field", "steps"), m);
+  const l0 = layoutKey(doc), k0 = docKey(doc);
+  setFieldValue(doc, nodeRef("n1", "field", "steps"), 7);
+  assert.equal(layoutKey(doc), l0);
+  assert.notEqual(docKey(doc), k0);
+  const moved = { ...doc, blocks: doc.blocks.map((b) => ({ ...b, x: b.x + 1 })) };
+  assert.notEqual(layoutKey(moved), l0);
+  const renamed = { ...doc, blocks: doc.blocks.map((b) => ({ ...b, title: "T" })) };
+  assert.notEqual(layoutKey(renamed), l0);
+});
+
+test("toSaveDoc stamps format and normalises optional block fields; statusByBlock maps ids", () => {
+  const doc = toSaveDoc({ ...emptyDoc("monitor"), blocks: [{ id: "b1", ref: graphRef("display", "run"), x: 0, y: 0, w: 1, h: 1 }] });
+  assert.equal(doc.format, 1);
+  assert.deepEqual([doc.blocks[0].collapsed, doc.blocks[0].title, doc.blocks[0].options], [false, null, {}]);
+  assert.deepEqual(statusByBlock({ blocks: [{ id: "b1", status: "wired" }] }), { b1: "wired" });
+  assert.deepEqual(statusByBlock(null), {});
+});
diff --git a/frontend/tests/board_series.test.mjs b/frontend/tests/board_series.test.mjs
new file mode 100644
index 0000000..f66f4c8
--- /dev/null
+++ b/frontend/tests/board_series.test.mjs
@@ -0,0 +1,197 @@
+/* Unit tests for board/series.js -- live data handling. Pure; the clock is passed in. */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  StreamState, barsOf, chartRows, decimate, formatDuration, formatValue, globToRegExp,
+  progressOf, referenceLines, scalarOf, seriesFor, textOf, xOf,
+} from "../js/board/series.js";
+
+const step = (n, extra = {}) => ({ step: n, total_steps: 100, loss: 1 / n, ...extra });
+
+test("frames: connected / clear / run_end / unknown type / not-telemetry / garbage", () => {
+  const s = new StreamState();
+  assert.equal(s.applyFrame({ type: "connected" }).kind, "connected");
+  assert.equal(s.conn, "live");
+  assert.equal(s.applyFrame(step(1)).kind, "point");
+  assert.equal(s.applyFrame({ type: "mystery", step: 2 }).kind, "ignored");
+  assert.equal(s.applyFrame({ hello: "world" }).kind, "ignored");
+  assert.equal(s.rows.length, 1);
+  assert.equal(s.applyRaw("{not json").kind, "bad");
+  assert.equal(s.applyFrame([1, 2]).kind, "bad");
+  assert.equal(s.applyFrame(null).kind, "bad");
+  assert.equal(s.bad, 3);
+  assert.equal(s.applyFrame({ type: "run_end", step: 100, cancelled: false }).kind, "run_end");
+  assert.deepEqual(s.runEnd, { step: 100, cancelled: false });
+  s.applyFrame(step(2));                     // new report after run_end = a new run
+  assert.equal(s.runEnd, null);
+  s.applyFrame({ type: "clear" });
+  assert.equal(s.rows.length, 0);
+  assert.equal(s.conn, "live", "clear keeps the connection");
+  assert.equal(Object.keys(s.last).length, 0);
+});
+
+test("a reconnect's replay does not duplicate history", () => {
+  const s = new StreamState();
+  s.applyFrame({ type: "connected" });
+  for (let i = 1; i <= 5; i++) s.applyFrame(step(i));
+  s.setConn("disconnected");
+  s.applyFrame({ type: "connected" });            // EventSource reconnected
+  for (let i = 1; i <= 7; i++) s.applyFrame(step(i)); // server replays all it holds
+  assert.equal(s.rows.length, 7);
+  assert.equal(s.conn, "live");
+});
+
+test("a key missing from a frame is a gap, and non-finite numbers are gaps", () => {
+  const s = new StreamState();
+  s.applyFrame({ step: 1, a: 1, b: 2 });
+  s.applyFrame({ step: 2, a: 3 });
+  s.applyFrame({ step: 3, a: null, b: null });
+  const rows = chartRows(s, { x: "step" }, ["a", "b"]);
+  assert.deepEqual(rows.map((r) => r.values), [{ a: 1, b: 2 }, { a: 3, b: null }, { a: null, b: null }]);
+});
+
+test("x=t is seconds since the first timed frame after a clear", () => {
+  const s = new StreamState();
+  s.applyFrame({ t: 1000.0, reserved_mb: 10 });
+  s.applyFrame({ t: 1002.5, reserved_mb: 20 });
+  assert.deepEqual(chartRows(s, { x: "t" }, ["reserved_mb"]).map((r) => r.x), [0, 2.5]);
+  assert.equal(xOf(s, { step: 4 }, "step"), 4);
+  assert.equal(xOf(s, { step: 4 }, "t"), null);
+  s.applyFrame({ type: "clear" });
+  s.applyFrame({ t: 5000, reserved_mb: 1 });
+  assert.equal(chartRows(s, { x: "t" }, ["reserved_mb"])[0].x, 0);
+});
+
+test("row cap drops the oldest and says how many", () => {
+  const s = new StreamState({ maxRows: 10 });
+  for (let i = 1; i <= 25; i++) s.applyFrame(step(i));
+  assert.equal(s.rows.length, 10);
+  assert.equal(s.dropped, 15);
+  assert.equal(s.rows[0].frame.step, 16);
+  assert.equal(s.last.loss.x.step, 25, "latest survives");
+});
+
+test("glob matches like fnmatch", () => {
+  const re = globToRegExp("*_ms");
+  assert.ok(re.test("fwd_ms") && re.test("_ms") && !re.test("ms_x") && !re.test("fwd_msx"));
+  assert.ok(globToRegExp("a?c").test("abc") && !globToRegExp("a?c").test("ac"));
+  assert.ok(globToRegExp("[ab]x").test("ax") && !globToRegExp("[ab]x").test("cx"));
+  assert.ok(globToRegExp("[!a]x").test("bx") && !globToRegExp("[!a]x").test("ax"));
+  assert.ok(globToRegExp("a.b").test("a.b") && !globToRegExp("a.b").test("aXb"), "dot is literal");
+  assert.ok(globToRegExp("a[b").test("a[b"), "unclosed bracket is literal");
+});
+
+test("seriesFor: declared + discovered (pattern, minus exclusions), colours stable as keys arrive", () => {
+  const mod = { series: [{ key: "step_total_ms", label: "total", color: "#111" }], pattern: "*_ms", exclude: ["skip_ms"] };
+  const s = new StreamState();
+  s.applyFrame({ step: 1, step_total_ms: 9, fwd_ms: 3, skip_ms: 1, loss: 0.5 });
+  let list = seriesFor(mod, s);
+  assert.deepEqual(list.map((x) => x.key), ["step_total_ms", "fwd_ms"]);
+  assert.equal(list[0].color, "#111");
+  assert.equal(list[1].label, "fwd");
+  const fwdColor = list[1].color;
+  s.applyFrame({ step: 2, step_total_ms: 9, fwd_ms: 3, bwd_ms: 4 });
+  list = seriesFor(mod, s);
+  assert.deepEqual(list.map((x) => x.key), ["step_total_ms", "fwd_ms", "bwd_ms"]);
+  assert.equal(list[1].color, fwdColor, "an existing series must not change colour");
+  assert.ok(list.every((x) => x.color));
+  assert.deepEqual(seriesFor({ series: [{ key: "a" }] }, s).map((x) => x.label), ["a"]);
+});
+
+test("decimate keeps every series' extremes, first and last, in order, with original rows", () => {
+  const rows = Array.from({ length: 10000 }, (_, i) => ({
+    x: i, values: { a: Math.sin(i / 50), b: i % 997 === 0 ? 100 : 1 },
+  }));
+  rows[4321].values.a = 50;           // a one-step spike
+  rows[7777].values.a = -50;          // and a one-step dip
+  const out = decimate(rows, 400, ["a", "b"]);
+  assert.ok(out.length <= 400, `got ${out.length}`);
+  assert.ok(out.includes(rows[4321]) && out.includes(rows[7777]), "spike or dip lost");
+  assert.equal(out[0], rows[0]);
+  assert.equal(out[out.length - 1], rows[rows.length - 1]);
+  for (let i = 1; i < out.length; i++) assert.ok(out[i].x > out[i - 1].x);
+  assert.ok(out.every((r) => rows.includes(r)), "decimate must not invent rows");
+  assert.equal(decimate(rows.slice(0, 50), 400, ["a"]).length, 50, "short input untouched");
+});
+
+test("decimate survives all-gap series and many series", () => {
+  const rows = Array.from({ length: 5000 }, (_, i) => ({ x: i, values: { a: null, b: i } }));
+  const out = decimate(rows, 100, ["a", "b"]);
+  assert.ok(out.length <= 100 && out.length >= 2);
+  const many = Array.from({ length: 5000 }, (_, i) => ({ x: i, values: Object.fromEntries(Array.from({ length: 12 }, (_, k) => [`k${k}`, (i * (k + 1)) % 97])) }));
+  const keys = Array.from({ length: 12 }, (_, k) => `k${k}`);
+  assert.ok(decimate(many, 200, keys).length <= 200);
+});
+
+test("scalar: latest value, stale when the newest frame lacks the key", () => {
+  const mod = { series: [{ key: "lr" }] };
+  const s = new StreamState();
+  assert.equal(scalarOf(mod, s), null);
+  s.applyFrame({ step: 1, lr: 0.001 });
+  assert.equal(scalarOf(mod, s).stale, false);
+  s.applyFrame({ step: 2 });
+  const r = scalarOf(mod, s);
+  assert.deepEqual([r.value, r.stale, r.x.step], [0.001, true, 1]);
+});
+
+test("bars: newest present value per series, absent series omitted", () => {
+  const mod = { series: [{ key: "a" }, { key: "b" }] };
+  const s = new StreamState();
+  s.applyFrame({ step: 1, a: 4 });
+  assert.deepEqual(barsOf(mod, s).map((b) => [b.key, b.value]), [["a", 4]]);
+  s.applyFrame({ step: 2, a: 5, b: 6 });
+  assert.deepEqual(barsOf(mod, s).map((b) => [b.key, b.value]), [["a", 5], ["b", 6]]);
+});
+
+test("text keeps strings; reference line is the latest numeric reference value", () => {
+  const s = new StreamState();
+  s.applyFrame({ step: 1, status: "warming up", budget_mb: 9000 });
+  assert.equal(textOf({ series: [{ key: "status" }] }, s), "warming up");
+  assert.equal(textOf({ series: [{ key: "nope" }] }, s), null);
+  assert.equal(textOf({ series: [] }, s), null);
+  assert.deepEqual(referenceLines({ reference_key: "budget_mb" }, s), [{ value: 9000, label: "budget", color: "#ff9800" }]);
+  assert.deepEqual(referenceLines({ reference_key: "nope" }, s), []);
+  assert.deepEqual(referenceLines({}, s), []);
+});
+
+test("progress: fraction, rate and ETA from arrival times; none from a single sample", () => {
+  const mod = { value_key: "step", total_key: "total_steps" };
+  const s = new StreamState();
+  assert.equal(progressOf(mod, s), null);
+  s.applyFrame(step(10), 0);
+  let p = progressOf(mod, s);
+  assert.deepEqual([p.value, p.total, p.fraction, p.rate, p.eta], [10, 100, 0.1, null, null]);
+  s.applyFrame(step(20), 10_000);           // 10 steps / 10 s
+  p = progressOf(mod, s);
+  assert.equal(p.rate, 1);
+  assert.equal(p.eta, 80);
+  const burst = new StreamState();                 // a late page: history replayed at once
+  for (let i = 1; i <= 40; i++) burst.applyFrame(step(i), 5000 + i);
+  assert.deepEqual([progressOf(mod, burst).rate, progressOf(mod, burst).eta], [null, null]);
+  s.applyFrame(step(20), 20_000);           // stalled: dv = 0 over the window? window still spans 10->20
+  p = progressOf(mod, s);
+  assert.ok(p.rate > 0 && p.rate < 1);
+  s.applyFrame({ type: "run_end", step: 100 });
+  p = progressOf(mod, s);
+  assert.equal(p.done, true);
+  assert.equal(p.eta, null);
+  // no total: fraction unknown, never NaN
+  const t = new StreamState();
+  t.applyFrame({ step: 5 }, 0);
+  assert.deepEqual([progressOf(mod, t).total, progressOf(mod, t).fraction], [null, null]);
+});
+
+test("formatting", () => {
+  assert.equal(formatDuration(0), "0s");
+  assert.equal(formatDuration(65), "1m 05s");
+  assert.equal(formatDuration(3720), "1h 02m");
+  assert.equal(formatDuration(null), "—");
+  assert.equal(formatDuration(NaN), "—");
+  assert.equal(formatValue(1234567), "1,234,567");
+  assert.equal(formatValue(0.000123456), "0.000123");
+  assert.equal(formatValue(2.5), "2.500");
+  assert.equal(formatValue(123.456), "123.5");
+  assert.equal(formatValue(null), "—");
+  assert.equal(formatValue(Infinity), "—");
+});
