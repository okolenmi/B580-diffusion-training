+
+/* displays fill their block: the body hosts them edge to edge */
+.bd-block[data-kind="display"] .bd-body { padding: 6px 8px; display: flex; flex-direction: column; }
+/* ...and `hidden` (a collapsed block) must still win over that display rule. */
+.bd-block .bd-body[hidden] { display: none; }
+.bd-chart { flex: 1; min-height: 0; position: relative; }
+.bd-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
+
+.bd-scalar { display: flex; flex-direction: column; justify-content: center; height: 100%; gap: 0; }
+.bd-scalar-value { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; line-height: 1.1; }
+.bd-scalar-unit { color: var(--text-dim); font-size: 12px; min-height: 1em; }
