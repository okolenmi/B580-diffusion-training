@@ -179,5 +179,18 @@ if __name__ == "__main__":
     args_util.verify_command_line_training_args(args)
     args = args_util.read_config_from_file(args, parser)
 
+    # `trainer.train()` does `importlib.import_module(args.network_module)` and
+    # then calls `create_network(1.0, dim, alpha, vae, text_encoder, unet,
+    # neuron_dropout=..., **net_kwargs)`. No training script registers a
+    # --network_module argument (only the *_gen_img generators do), so at this
