+/* ---------------------------------------------------------------------------
+   templates.css -- the Templates page (templates.html) and its board.
+
+   Sections:
+     1. page chrome: list view (new form, cards)
+     2. page view: toolbar, issues strip, work area (board + tray)
+     3. the board: grid, blocks, header, edit-mode affordances
+     4. block contents: fields, displays (chart, scalar, bars, progress,
+        status, text), orphans
+     5. tray
+     6. narrow screens + pop-out window mode
+   Tokens come from style.css; nothing here hard-codes the palette except the
+   few semantic tints (warning amber, error red) the rest of the app also uses.
+   --------------------------------------------------------------------------- */
+
+/* ---- 1. list view ---- */
+
+.tpl-body .page-topbar { flex-wrap: wrap; }
+.tpl-h2 {
+    font-size: 13px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
+    color: var(--text-dim); margin: 0 0 10px;
+}
+.tpl-new {
+    display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; padding: 16px 18px 6px;
+}
+.tpl-field { display: flex; flex-direction: column; gap: 4px; min-width: 200px; font-size: 12px; color: var(--text-dim); }
+.tpl-field-grow { flex: 1; min-width: 220px; }
+.tpl-field select, .tpl-field input[type="text"] { padding: 0.55rem 0.7rem; font-size: 13.5px; }
+.tpl-new-hint { padding: 4px 18px 14px; color: var(--text-dim); font-size: 12.5px; max-width: 80ch; }
+#new-card .error-box { margin: 0 18px 14px; }
+
+.tpl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
+.tpl-card {
+    display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: inherit;
+    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
+    padding: 14px 16px; transition: border-color var(--dur-fast), transform var(--dur-fast);
+}
+.tpl-card:hover { border-color: var(--accent); transform: translateY(-1px); }
+.tpl-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.tpl-card-name { font-weight: 700; font-size: 15px; overflow-wrap: anywhere; }
+.tpl-card-desc { color: var(--text-dim); font-size: 12.5px; min-height: 1.2em; }
+.tpl-card-meta { color: var(--text-dim); font-size: 11.5px; margin-top: auto; }
+
+/* ---- 2. page view ---- */
+
+.tpl-page { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; max-width: 1680px; }
+.tpl-toolbar {
+    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
+    position: sticky; top: -2.5rem; z-index: 5; padding: 8px 0;
+    background: linear-gradient(var(--bg) 70%, transparent);
+}
+.tpl-spacer { flex: 1; }
+.tpl-state { color: var(--text-dim); font-size: 12.5px; }
+.tpl-seg { display: inline-flex; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
+.tpl-seg-btn {
+    background: var(--surface-alt); color: var(--text-dim); border: 0; font: inherit;
+    font-size: 12.5px; font-weight: 700; padding: 0.4rem 0.9rem; cursor: pointer;
+}
+.tpl-seg-btn + .tpl-seg-btn { border-left: 1px solid var(--border); }
+.tpl-seg-btn:hover { color: var(--text); }
+.tpl-seg-btn.active { background: var(--accent); color: #fff; }
+.tpl-seg-btn:focus-visible { outline: 2px solid var(--text); outline-offset: -2px; }
+#btn-save.is-dirty { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
+
+.tpl-issues {
+    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
+    font-size: 13px;
+}
+.tpl-issues summary { padding: 8px 12px; cursor: pointer; color: var(--text-dim); font-weight: 600; }
+.tpl-issues.has-errors { border-color: rgba(239, 68, 68, 0.45); }
+.tpl-issues.has-errors summary { color: var(--red); }
+.tpl-issues ul { list-style: none; padding: 0 12px 10px 12px; display: flex; flex-direction: column; gap: 4px; }
+.tpl-issues li { border-left: 2px solid var(--border); padding-left: 8px; }
+.tpl-issues li.error { border-color: var(--red); }
+.tpl-issues li.warn { border-color: #f59e0b; }
+
+.tpl-work { display: flex; gap: 16px; align-items: flex-start; }
+.tpl-board { flex: 1; min-width: 0; }
+
+/* ---- 3. the board ---- */
