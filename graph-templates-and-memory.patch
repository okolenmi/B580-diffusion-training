diff --git a/frontend/js/board/board.js b/frontend/js/board/board.js
new file mode 100644
index 0000000..373d46a
--- /dev/null
+++ b/frontend/js/board/board.js
@@ -0,0 +1,483 @@
+/* ---------------------------------------------------------------------------
+   board/board.js -- the grid of blocks, for both a template page and a
+   monitor window (one engine, two hosts).
+
+   What it owns: turning a template document + the backend's modules answer
+   into DOM -- a CSS grid whose cells are the document's `x/y/w/h` -- and, in
+   edit mode, drag, resize, collapse, rename and remove. What it does not
+   own: the document (the page passes it in and is told when it changed),
+   the network (the page fetches modules/resolutions and hands them over)
+   and the arithmetic (board/layout.js, board/model.js, board/series.js --
+   all pure and unit-tested).
+
+   Two modes, one document:
+     use   -- the blocks are the interface. Fields are editable, displays
+              are live, nothing moves. (Collapsing a block is still allowed:
+              it hides what you do not want to look at.)
+     edit  -- the layout is editable too. Headers become drag handles, the
+              corner resizes, blocks can be renamed or removed.
+
+   Blocks are created once and then *re-placed* (a style change), never
+   rebuilt, when the layout moves: a chart keeps its data, a half-typed
+   field keeps its focus. A block's content is rebuilt only when what it
+   points at actually changed (`contentKey`).
+
+   On a narrow screen (< NARROW_PX) the grid collapses to one column in
+   reading order and drag is disabled -- a phone is for *using* a page.
+   --------------------------------------------------------------------------- */
+
+import { createDisplay } from "./displays.js";
+import { buildFieldControl } from "./fields.js";
+import {
+  cellDelta, columnWidth, effH, flowOrder, keyNudge, moveTo, resizeTo, resolve, setCollapsed,
+} from "./layout.js";
+import { addBlock, findTarget, patchBlock, removeBlock, titleFor } from "./model.js";
+
+export const ROW_PX = 48;
+export const GAP_PX = 10;
+export const NARROW_PX = 640;
+
+const STATUS_TEXT = {
+  wired: "set by the graph",
+  missing_node: "missing",
+  unknown_class: "missing",
+  missing_module: "missing",
+};
+
+const h = (tag, cls, text) => {
+  const e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text !== undefined) e.textContent = text;
+  return e;
+};
+
+function button(label, title, cls = "") {
+  const b = h("button", `bd-tool ${cls}`.trim(), label);
+  b.type = "button";
+  b.title = title;
+  b.setAttribute("aria-label", title);
+  return b;
+}
+
+export class Board {
+  /**
+   * @param {HTMLElement} container
+   * @param {object} opts
+   * @param {import("./live.js").LiveStreams} opts.live
+   * @param {object} [opts.ctx]       passed to displays (`ctx.execution()`)
+   * @param {(reason: string) => void} [opts.onChange]  "layout" | "blocks" | "value" | "title"
+   * @param {(msg: string, kind?: string) => void} [opts.onNote]
+   */
+  constructor(container, { live, ctx = {}, onChange = () => {}, onNote = () => {} }) {
+    this.container = container;
+    this.live = live;
+    this.ctx = ctx;
+    this.onChange = onChange;
+    this.onNote = onNote;
+    this.doc = null;
+    this.modules = null;
+    this.statuses = {};
+    this.mode = "use";
+    this.entries = new Map(); // block id -> entry
+    this.narrow = false;
+    this._pending = new Set();
+    this._raf = 0;
+
+    this.root = h("div", "bd-grid");
+    this.empty = h("div", "bd-grid-empty");
+    container.append(this.root, this.empty);
+
+    this._ro = new ResizeObserver(() => {
+      const narrow = container.clientWidth < NARROW_PX;
+      if (narrow !== this.narrow) { this.narrow = narrow; this.applyLayout(); }
+    });
+    this._ro.observe(container);
+    this.narrow = container.clientWidth > 0 && container.clientWidth < NARROW_PX;
+
+    // Elapsed-time readouts (run status) tick without any stream frame.
+    this._tick = setInterval(() => {
+      for (const e of this.entries.values()) if (e.tick) e.display.update();
+    }, 1000);
+  }
+
+  destroy() {
+    clearInterval(this._tick);
+    cancelAnimationFrame(this._raf);
+    this._ro.disconnect();
+    for (const e of this.entries.values()) this._disposeContent(e);
+    this.entries.clear();
+    this.container.replaceChildren();
+  }
+
+  /* ---- inputs ---------------------------------------------------------- */
+
+  setDoc(doc) {
+    this.doc = doc;
+    for (const e of this.entries.values()) { this._disposeContent(e); e.el.remove(); }
+    this.entries.clear();
+    this.sync();
+  }
+
+  setModules(modules) { this.modules = modules; this.sync(); }
+
+  /** @param {Record<string, {status: string, detail: string}>} statuses */
+  setStatuses(statuses) { this.statuses = statuses || {}; this.sync(); }
+
+  setMode(mode) {
+    this.mode = mode;
+    this.root.classList.toggle("bd-edit", mode === "edit");
+    this.applyLayout();
+    this._updateEmpty();
+  }
+
+  /** Redraw every display now (e.g. after the run state changed). */
+  refreshDisplays() {
+    for (const e of this.entries.values()) if (e.display) e.display.update();
+  }
+
+  /** Re-evaluate field gating (a value elsewhere may have moved a gate). */
+  refreshFields() {
+    for (const e of this.entries.values()) if (e.field) e.field.refresh();
+  }
+
+  /* ---- document operations the page calls ------------------------------ */
+
+  addRef(ref) {
+    const before = new Set(this.doc.blocks.map((b) => b.id));
+    const next = addBlock(this.doc, ref, this.modules);
+    if (next === this.doc) return null;
+    this.doc.blocks = next.blocks;
+    this.sync();
+    this.onChange("blocks");
+    const added = this.doc.blocks.find((b) => !before.has(b.id)) || null;
+    const entry = added && this.entries.get(added.id);
+    if (entry) entry.el.scrollIntoView({ block: "nearest", behavior: "smooth" });
+    return added;
+  }
+
+  removeId(id) {
+    this.doc.blocks = removeBlock(this.doc, id).blocks;
+    this.sync();
+    this.onChange("blocks");
+  }
+
+  /* ---- build / sync ---------------------------------------------------- */
+
+  /** Make the DOM match the document: create new blocks, drop removed
+      ones, rebuild content whose target changed, re-place everything. */
+  sync() {
+    if (!this.doc) return;
+    const ids = new Set(this.doc.blocks.map((b) => b.id));
+    for (const [id, e] of this.entries) {
+      if (!ids.has(id)) { this._disposeContent(e); e.el.remove(); this.entries.delete(id); }
+    }
+    for (const block of this.doc.blocks) {
+      let entry = this.entries.get(block.id);
+      if (!entry) {
+        entry = this._createEntry(block);
+        this.entries.set(block.id, entry);
+        this.root.append(entry.el);
+      }
+      entry.block = block;
+      this._renderHeader(entry);
+      const key = this._contentKey(block);
+      if (entry.contentKey !== key) this._buildContent(entry, key);
+    }
+    this.applyLayout();
+    this._updateEmpty();
+  }
+
+  _contentKey(block) {
+    const st = this.statuses[block.id];
+    const { node, descriptor } = findTarget(block.ref, this.modules);
+    // value/has_value change with every keystroke; they must not rebuild a
+    // control the person is typing into.
+    const stable = descriptor
+      ? JSON.stringify(descriptor, (k, v) => (k === "value" || k === "has_value" ? undefined : v))
+      : "none";
+    return `${st ? st.status : "ok"}|${this.modules ? "m" : "-"}|${node ? node.stream : ""}|${stable}`;
+  }
+
+  _createEntry(block) {
+    const el = h("article", "bd-block");
+    el.dataset.id = block.id;
+    el.dataset.kind = block.ref.kind;
+    const head = h("header", "bd-head");
+    const grip = h("span", "bd-grip", "⋮⋮");
+    grip.setAttribute("aria-hidden", "true");
+    const titles = h("div", "bd-titles");
+    const title = h("span", "bd-title");
+    const sub = h("span", "bd-sub");
+    titles.append(title, sub);
+    const badge = h("span", "bd-badge");
+    badge.hidden = true;
+    const tools = h("div", "bd-tools");
+    const collapse = button("▾", "Collapse / expand");
+    const rename = button("✎", "Rename this block", "bd-edit-only");
+    const remove = button("✕", "Remove this block from the page", "bd-edit-only");
+    tools.append(collapse, rename, remove);
+    head.append(grip, titles, badge, tools);
+    const body = h("div", "bd-body");
+    const resizer = h("div", "bd-resize");
+    resizer.title = "Drag to resize";
+    el.append(head, body, resizer);
+
+    const entry = {
+      el, head, title, sub, badge, body, block, contentKey: null,
+      display: null, field: null, release: null, tick: false, lastUpdate: 0,
+    };
+
+    collapse.addEventListener("click", () => this._toggleCollapse(entry.block.id));
+    remove.addEventListener("click", () => this.removeId(entry.block.id));
+    rename.addEventListener("click", () => this._startRename(entry));
+    title.addEventListener("dblclick", () => { if (this.mode === "edit") this._startRename(entry); });
+    head.addEventListener("pointerdown", (ev) => this._startDrag(ev, entry, "move"));
+    resizer.addEventListener("pointerdown", (ev) => this._startDrag(ev, entry, "resize"));
+    head.tabIndex = 0;
+    head.addEventListener("keydown", (ev) => this._onKey(ev, entry));
+    return entry;
+  }
+
+  _renderHeader(entry) {
+    const { block } = entry;
+    const t = titleFor(block, this.modules);
+    if (!entry.renaming) entry.title.textContent = t.title;
+    entry.sub.textContent = t.subtitle;
+    const st = this.statuses[block.id];
+    const label = st && st.status !== "ok" ? STATUS_TEXT[st.status] || st.status : "";
+    entry.badge.hidden = !label;
+    entry.badge.textContent = label;
+    entry.badge.title = st ? st.detail : "";
+    entry.badge.dataset.status = st ? st.status : "";
+    entry.el.dataset.status = st ? st.status : "ok";
+    entry.el.classList.toggle("is-collapsed", !!block.collapsed);
+    entry.body.hidden = !!block.collapsed;
+  }
+
+  _disposeContent(entry) {
+    if (entry.display) { entry.display.destroy(); entry.display = null; }
+    if (entry.release) { entry.release(); entry.release = null; }
+    entry.field = null;
+    entry.tick = false;
+    entry.body.replaceChildren();
+  }
+
+  _buildContent(entry, key) {
+    this._disposeContent(entry);
+    entry.contentKey = key;
+    const { block } = entry;
+    const st = this.statuses[block.id];
+    const status = st ? st.status : "ok";
+
+    if (!this.modules) { entry.body.append(h("div", "bd-empty", "loading…")); return; }
+
+    const { node, descriptor } = findTarget(block.ref, this.modules);
+    if (status.startsWith("missing") || status === "unknown_class" || !descriptor) {
+      const box = h("div", "bd-orphan");
+      box.append(
+        h("strong", "", "This block has lost its target."),
+        h("span", "", st && st.detail ? st.detail : "The graph no longer has what this block shows."),
+      );
+      if (this.mode === "edit") box.append(h("span", "bd-orphan-hint", "Remove it with ✕, or restore the node in the graph."));
+      entry.body.append(box);
+      return;
+    }
+
+    if (block.ref.kind === "field") {
+      if (status === "wired") {
+        entry.body.append(h("div", "bd-wired",
+          "This value comes from another node in the graph, so it is not set here."));
+        return;
+      }
+      const siblings = node ? node.fields : this.modules.graph_fields;
+      const field = buildFieldControl({
+        block, descriptor, siblings, doc: this.doc,
+        onChange: (origin) => { this.refreshFields(); this.onChange(origin); },
+        onNote: this.onNote,
+      });
+      entry.field = field;
+      entry.body.append(field.el);
+      return;
+    }
+
+    // display
+    const streamId = descriptor.stream || (node && node.stream) || null;
+    let state = null;
+    if (streamId) {
+      const handle = this.live.acquire(streamId, () => this._schedule(entry));
+      entry.release = handle.release;
+      state = handle.state;
+    }
+    entry.display = createDisplay({
+      module: descriptor, state: state || emptyState(), ctx: this.ctx,
+    });
+    entry.tick = descriptor.kind === "status";
+    entry.body.append(entry.display.el);
+    entry.display.update();
+  }
+
+  /* ---- throttled redraw ------------------------------------------------ */
+
+  _schedule(entry) {
+    this._pending.add(entry);
+    if (this._raf) return;
+    this._raf = requestAnimationFrame(() => {
+      this._raf = 0;
+      const now = performance.now();
+      for (const e of [...this._pending]) {
+        if (!e.display || e.block.collapsed) { this._pending.delete(e); continue; }
+        const min = e.block.ref.kind === "display" && e.display.el.querySelector("canvas") ? 250 : 80;
+        if (now - e.lastUpdate >= min) {
+          e.lastUpdate = now;
+          this._pending.delete(e);
+          e.display.update();
+        }
+      }
+      if (this._pending.size) this._schedule([...this._pending][0]);
+    });
+  }
+
+  /* ---- layout ---------------------------------------------------------- */
+
+  applyLayout() {
+    if (!this.doc) return;
+    const cols = this.narrow ? 1 : this.doc.columns;
+    this.root.style.setProperty("--bd-cols", String(cols));
+    this.root.style.setProperty("--bd-row", `${ROW_PX}px`);
+    this.root.style.setProperty("--bd-gap", `${GAP_PX}px`);
+    this.root.classList.toggle("bd-narrow", this.narrow);
+    const order = new Map(flowOrder(this.doc.blocks).map((b, i) => [b.id, i]));
+    for (const b of this.doc.blocks) {
+      const e = this.entries.get(b.id);
+      if (!e) continue;
+      e.block = b;
+      if (this.narrow) {
+        e.el.style.gridColumn = "1";
+        e.el.style.gridRow = `auto / span ${effH(b)}`;
+        e.el.style.order = String(order.get(b.id));
+      } else {
+        e.el.style.gridColumn = `${b.x + 1} / span ${b.w}`;
+        e.el.style.gridRow = `${b.y + 1} / span ${effH(b)}`;
+        e.el.style.order = "";
+      }
+      e.el.classList.toggle("is-collapsed", !!b.collapsed);
+      e.body.hidden = !!b.collapsed;
+    }
+  }
+
+  _updateEmpty() {
+    const none = !this.doc || this.doc.blocks.length === 0;
+    this.empty.hidden = !none;
+    this.empty.textContent = this.mode === "edit"
+      ? "Nothing here yet. Add blocks from the list on the right."
+      : "This page is empty. Switch to Edit to add blocks.";
+  }
+
+  _toggleCollapse(id) {
+    const b = this.doc.blocks.find((x) => x.id === id);
+    if (!b) return;
+    this.doc.blocks = setCollapsed(this.doc.blocks, id, !b.collapsed, this.doc.columns);
+    this.applyLayout();
+    this.onChange("layout");
+  }
+
+  /* ---- rename ---------------------------------------------------------- */
+
+  _startRename(entry) {
+    if (entry.renaming) return;
+    entry.renaming = true;
+    const { block } = entry;
+    const input = h("input", "bd-rename");
+    input.type = "text";
+    input.maxLength = 120;
+    input.value = entry.title.textContent;
+    input.setAttribute("aria-label", "Block title");
+    entry.title.replaceChildren(input);
+    input.focus();
+    input.select();
+    const finish = (commit) => {
+      if (!entry.renaming) return;
+      entry.renaming = false;
+      const text = input.value.trim();
+      if (commit) {
+        const t = titleFor({ ...block, title: null }, this.modules);
+        const next = text && text !== t.defaultTitle ? text : null;
+        if (next !== (block.title || null)) {
+          this.doc.blocks = patchBlock(this.doc, block.id, { title: next }).blocks;
+          this.onChange("title");
+        }
+      }
+      this.sync();
+    };
+    input.addEventListener("keydown", (ev) => {
+      if (ev.key === "Enter") { ev.preventDefault(); finish(true); }
+      else if (ev.key === "Escape") { ev.preventDefault(); finish(false); }
+      ev.stopPropagation();
+    });
+    input.addEventListener("blur", () => finish(true));
+    input.addEventListener("pointerdown", (ev) => ev.stopPropagation());
+  }
+
+  /* ---- drag / resize / keyboard (edit mode) ----------------------------- */
+
+  _startDrag(ev, entry, what) {
+    if (this.mode !== "edit" || this.narrow || ev.button !== 0) return;
+    if (ev.target.closest(".bd-tool, .bd-rename")) return;
+    ev.preventDefault();
+    const id = entry.block.id;
+    const original = this.doc.blocks.map((b) => ({ ...b }));
+    const start = original.find((b) => b.id === id);
+    const width = this.root.clientWidth;
+    const colW = columnWidth(width, this.doc.columns, GAP_PX);
+    const x0 = ev.clientX, y0 = ev.clientY;
+    const target = ev.currentTarget;
+    target.setPointerCapture(ev.pointerId);
+    entry.el.classList.add("is-dragging");
+
+    const move = (e2) => {
+      const d = cellDelta(e2.clientX - x0, e2.clientY - y0, colW, ROW_PX, GAP_PX);
+      this.doc.blocks = what === "move"
+        ? moveTo(original, id, start.x + d.dCols, start.y + d.dRows, this.doc.columns)
+        : resizeTo(original, id, start.w + d.dCols, start.h + d.dRows, this.doc.columns);
+      this.applyLayout();
+    };
+    const finish = (commit) => {
+      target.removeEventListener("pointermove", move);
+      target.removeEventListener("pointerup", up);
+      target.removeEventListener("pointercancel", cancel);
+      document.removeEventListener("keydown", esc, true);
+      entry.el.classList.remove("is-dragging");
+      if (!commit) { this.doc.blocks = original; this.applyLayout(); return; }
+      const moved = JSON.stringify(original) !== JSON.stringify(this.doc.blocks);
+      if (moved) this.onChange("layout");
+    };
+    const up = () => finish(true);
+    const cancel = () => finish(false);
+    const esc = (e3) => { if (e3.key === "Escape") { e3.stopPropagation(); finish(false); } };
+    target.addEventListener("pointermove", move);
+    target.addEventListener("pointerup", up);
+    target.addEventListener("pointercancel", cancel);
+    document.addEventListener("keydown", esc, true);
+  }
+
+  _onKey(ev, entry) {
+    if (this.mode !== "edit" || ev.target !== entry.head) return;
+    const next = keyNudge(this.doc.blocks, entry.block.id, ev.key, ev.shiftKey, this.doc.columns);
+    if (next === this.doc.blocks) return;
+    ev.preventDefault();
+    this.doc.blocks = next;
+    this.applyLayout();
+    this.onChange("layout");
+  }
+}
+
+/** A stream that never has data, for a display whose module names no
+    stream (a status block, or a descriptor from an older backend). */
+function emptyState() {
+  return {
+    rows: [], last: {}, keys: new Set(), t0: null, runEnd: null, latestFrame: null,
+    conn: "connecting", dropped: 0, bad: 0,
+  };
+}
+
+export { resolve as settleLayout };
diff --git a/frontend/js/board/displays.js b/frontend/js/board/displays.js
new file mode 100644
index 0000000..92ecd6f
--- /dev/null
+++ b/frontend/js/board/displays.js
@@ -0,0 +1,246 @@
+/* ---------------------------------------------------------------------------
+   board/displays.js -- how each display *kind* is drawn.
+
+   The backend says what a live view *is* (nodes/ui.py: kind chart | scalar |
+   bars | text | progress, plus the graph's own `status`); this file is the
+   only place that knows what each looks like. A new module of an existing
+   kind needs no change here; a new kind is one function below, and an
+   unknown kind degrades to a labelled placeholder rather than a blank hole.
+
+   Every factory returns {el, update(), destroy()}. `update()` re-derives the
+   picture from the shared `StreamState` (board/series.js) and is cheap to
+   call -- the board throttles it. Nothing here keeps data of its own, so a
+   block that is collapsed, removed and re-added shows the same thing.
+   --------------------------------------------------------------------------- */
+
+import { LossChart } from "../lib/loss_chart.js";
+import {
+  barsOf, chartRows, decimate, formatDuration, formatValue, progressOf,
+  referenceLines, scalarOf, seriesFor, textOf,
+} from "./series.js";
+
+/** Points a chart is asked to draw. More than the plot has pixels for is
+    wasted work; decimate() keeps the extremes so it is never a lie. */
+const MAX_DRAWN_ROWS = 800;
+
+const div = (cls, text) => {
+  const d = document.createElement("div");
+  if (cls) d.className = cls;
+  if (text !== undefined) d.textContent = text;
+  return d;
+};
+
+/* ---- chart --------------------------------------------------------------- */
+
+function chartDisplay({ module, state }) {
+  const root = div("bd-chart");
+  const canvas = document.createElement("canvas");
+  canvas.className = "bd-canvas";
+  root.append(canvas);
+  let chart = null;
+  let signature = "";
+  const hidden = new Map(); // series key -> hidden, survives a rebuild
+
+  const build = (list) => {
+    if (chart) {
+      for (const s of chart.series) hidden.set(s.key, !!s.hidden);
+      chart.destroy();
+    }
+    chart = new LossChart(canvas, {
+      series: list.map((s) => ({
+        key: s.key, label: s.label, color: s.color, hidden: hidden.get(s.key) || false,
+      })),
+      maxPoints: MAX_DRAWN_ROWS + 8,
+      scale: module.scale === "linear" ? "linear" : "symlog",
+      smoothWindow: module.scale === "linear" ? 3 : 24,
+      xLabel: module.x === "t" ? "t (s)" : "Step",
+    });
+    signature = list.map((s) => `${s.key}:${s.color}`).join("|");
+  };
+
+  return {
+    el: root,
+    update() {
+      const list = seriesFor(module, state);
+      if (!list.length) return;
+      if (!chart || signature !== list.map((s) => `${s.key}:${s.color}`).join("|")) build(list);
+      const keys = list.map((s) => s.key);
+      const rows = decimate(chartRows(state, module, keys), MAX_DRAWN_ROWS, keys);
+      chart.reset();
+      for (const r of rows) chart.addPoint(r.x, r.values);
+      chart.setReferenceLines(referenceLines(module, state));
+    },
+    destroy() { if (chart) chart.destroy(); },
+  };
+}
+
+/* ---- scalar -------------------------------------------------------------- */
+
+function scalarDisplay({ module, state }) {
+  const root = div("bd-scalar");
+  const value = div("bd-scalar-value", "—");
+  const unit = div("bd-scalar-unit");
+  const sub = div("bd-scalar-sub");
+  root.append(value, unit, sub);
+  return {
+    el: root,
+    update() {
+      const r = scalarOf(module, state);
+      if (!r) { value.textContent = "—"; unit.textContent = ""; sub.textContent = "waiting for data"; return; }
+      value.textContent = formatValue(r.value);
+      unit.textContent = r.series.unit || "";
+      const ref = referenceLines(module, state)[0];
+      const against = ref ? ` · of ${formatValue(ref.value)}${r.series.unit ? " " + r.series.unit : ""}` : "";
+      sub.textContent = r.stale
+        ? `last seen at ${module.x === "t" ? formatDuration(r.x.t) : "step " + r.x.step}${against}`
+        : `${r.series.label}${against}`;
+      root.classList.toggle("is-stale", r.stale);
+    },
+    destroy() {},
+  };
+}
+
+/* ---- bars ---------------------------------------------------------------- */
+
+function barsDisplay({ module, state }) {
+  const root = div("bd-bars");
+  return {
+    el: root,
+    update() {
+      const items = barsOf(module, state);
+      root.replaceChildren();
+      if (!items.length) { root.append(div("bd-empty", "waiting for data")); return; }
+      const max = Math.max(...items.map((i) => i.value), 1e-9);
+      for (const it of items) {
+        const row = div("bd-bar-row");
+        const label = div("bd-bar-label", it.label);
+        const track = div("bd-bar-track");
+        const fill = div("bd-bar-fill");
+        fill.style.width = `${Math.max(0, (it.value / max) * 100)}%`;
+        fill.style.background = it.color;
+        track.append(fill);
+        const val = div("bd-bar-value", `${formatValue(it.value)}${it.unit ? " " + it.unit : ""}`);
+        row.append(label, track, val);
+        root.append(row);
+      }
+    },
+    destroy() {},
+  };
+}
+
+/* ---- text ---------------------------------------------------------------- */
+
+function textDisplay({ module, state }) {
+  const root = div("bd-text", "—");
+  return {
+    el: root,
+    update() {
+      const t = textOf(module, state);
+      root.textContent = t === null ? "—" : t;
+    },
+    destroy() {},
+  };
+}
+
+/* ---- progress ------------------------------------------------------------ */
+
+function progressDisplay({ module, state }) {
+  const root = div("bd-progress");
+  const head = div("bd-progress-head");
+  const left = div("bd-progress-count", "—");
+  const right = div("bd-progress-eta");
+  head.append(left, right);
+  const track = div("bd-progress-track");
+  const fill = div("bd-progress-fill");
+  track.append(fill);
+  root.append(head, track);
+  return {
+    el: root,
+    update() {
+      const p = progressOf(module, state);
+      if (!p) { left.textContent = "waiting for data"; right.textContent = ""; fill.style.width = "0%"; return; }
+      const pct = p.fraction === null ? null : Math.round(p.fraction * 1000) / 10;
+      left.textContent = p.total
+        ? `${formatValue(p.value)} / ${formatValue(p.total)}${pct === null ? "" : ` · ${pct}%`}`
+        : formatValue(p.value);
+      const bits = [];
+      if (p.rate) bits.push(`${p.rate >= 10 ? p.rate.toFixed(0) : p.rate.toFixed(2)}/s`);
+      if (p.done) bits.push(state.runEnd.cancelled ? "cancelled" : "finished");
+      else if (p.eta !== null) bits.push(`ETA ${formatDuration(p.eta)}`);
+      right.textContent = bits.join(" · ");
+      fill.style.width = `${p.fraction === null ? 0 : p.fraction * 100}%`;
+      root.classList.toggle("is-done", p.done);
+    },
+    destroy() {},
+  };
+}
+
+/* ---- graph run status ---------------------------------------------------- */
+
+/* The run states the backend actually has (domain/value_objects.GraphStatus):
+   queued, running, finished, error, stopped. */
+const STATUS_CLASS = {
+  queued: "status-idle", running: "status-running", finished: "status-completed",
+  error: "status-failed", stopped: "status-cancelled",
+};
+
+/** The run's state, from `ctx.execution()` -- polled by the page, since a
+    run's lifecycle is persisted state rather than a monitor stream:
+    `{execution_id, status, started_at, finished_at, error, done, total}`. */
+function statusDisplay({ ctx }) {
+  const root = div("bd-status");
+  const pill = document.createElement("span");
+  pill.className = "status-badge status-idle";
+  pill.textContent = "no run yet";
+  const line = div("bd-status-line");
+  const err = div("bd-status-error");
+  err.hidden = true;
+  const top = div("bd-status-top");
+  top.append(pill);
+  root.append(top, line, err);
+  return {
+    el: root,
+    update() {
+      const e = ctx && ctx.execution ? ctx.execution() : null;
+      if (!e) {
+        pill.className = "status-badge status-idle";
+        pill.textContent = "no run yet";
+        line.textContent = "Press Run to start.";
+        err.hidden = true;
+        return;
+      }
+      pill.className = `status-badge ${STATUS_CLASS[e.status] || "status-idle"}`;
+      pill.textContent = e.status;
+      const bits = [`#${e.execution_id}`];
+      if (e.started_at) {
+        const end = e.finished_at ? Date.parse(e.finished_at) : Date.now();
+        bits.push(formatDuration((end - Date.parse(e.started_at)) / 1000));
+      }
+      if (e.total) bits.push(`${e.done || 0} / ${e.total} nodes finished`);
+      line.textContent = bits.join(" · ");
+      err.hidden = !e.error;
+      err.textContent = e.error || "";
+    },
+    destroy() {},
+  };
+}
+
+/* ---- dispatch ------------------------------------------------------------ */
+
+const KINDS = {
+  chart: chartDisplay, scalar: scalarDisplay, bars: barsDisplay,
+  text: textDisplay, progress: progressDisplay, status: statusDisplay,
+};
+
+export const KNOWN_KINDS = Object.keys(KINDS);
+
+/** A display for `module` (a descriptor from /templates/modules), reading
+    `state`. An unknown kind gets a placeholder that says so. */
+export function createDisplay({ module, state, ctx }) {
+  const make = KINDS[module.kind];
+  if (!make) {
+    const el = div("bd-empty", `This page does not know how to draw a "${module.kind}" view.`);
+    return { el, update() {}, destroy() {} };
+  }
+  return make({ module, state, ctx });
+}
diff --git a/frontend/js/board/fields.js b/frontend/js/board/fields.js
new file mode 100644
index 0000000..66a0210
--- /dev/null
+++ b/frontend/js/board/fields.js
@@ -0,0 +1,178 @@
+/* ---------------------------------------------------------------------------
+   board/fields.js -- the control inside a *field* block.
+
+   A field block edits one value of the template's draft graph: a node's
+   input port, or one of the graph's own settings. The control is the graph
+   editor's own (`editor/widgets.js` `buildWidget`), driven from the same port
+   description the backend sent, so a value looks and validates the same on
+   the page as on the canvas and cannot drift from it.
+
+   `buildWidget` was written against the editor's document (`doc.classOf`,
+   `doc.changed`, `node.params`). Rather than fork it, this module hands it a
+   tiny stand-in with exactly those three members, backed by the draft:
+
+     node fields   -> the draft graph node's real `params` object;
+     graph fields  -> a `params` proxy that reads/writes `graph.memory`.
+
+   Two controls the editor's widget cannot draw are built here:
+     * "a number, or auto" (the VRAM budget);
+     * a bool that shows its *default* while unset.
+   --------------------------------------------------------------------------- */
+
+import { buildWidget, rowVisible } from "../editor/widgets.js";
+import { getFieldValue, setFieldValue } from "./model.js";
+
+/** `params` stand-in for a graph-scope field: the one key is the setting's
+    short name, and reads/writes go through the document model. */
+function memoryParams(doc, ref) {
+  const key = ref.name;
+  return new Proxy({}, {
+    get: (_t, prop) => (prop === key ? getFieldValue(doc, ref) : undefined),
+    set: (_t, prop, value) => { if (prop === key) setFieldValue(doc, ref, value); return true; },
+    deleteProperty: (_t, prop) => { if (prop === key) setFieldValue(doc, ref, undefined); return true; },
+    has: (_t, prop) => prop === key && getFieldValue(doc, ref) !== undefined,
+  });
+}
+
+function boolControl(descriptor, get, set) {
+  const wrap = document.createElement("label");
+  wrap.className = "param-label bd-bool";
+  const box = document.createElement("input");
+  box.type = "checkbox";
+  const text = document.createElement("span");
+  const show = () => {
+    const v = get();
+    box.checked = v === undefined || v === null ? descriptor.default === true : v === true;
+    text.textContent = box.checked ? "on" : "off";
+  };
+  box.addEventListener("change", () => { set(box.checked); show(); });
+  wrap.append(box, text);
+  show();
+  return wrap;
+}
+
+/** "auto" or a number: a checkbox for auto, and a number box that is
+    disabled while auto is on. Stored as the string "auto" or a number. */
+function autoNumberControl(descriptor, get, set) {
+  const wrap = document.createElement("div");
+  wrap.className = "bd-auto";
+  const box = document.createElement("input");
+  box.type = "checkbox";
+  const boxLabel = document.createElement("label");
+  boxLabel.className = "bd-auto-label";
+  const tx = document.createElement("span");
+  tx.textContent = "auto";
+  boxLabel.append(box, tx);
+  const num = document.createElement("input");
+  num.type = "number";
+  num.className = "cfg-input";
+  if (descriptor.minimum != null) num.min = String(descriptor.minimum);
+  if (descriptor.step != null) num.step = String(descriptor.step);
+  if (descriptor.unit) num.title = descriptor.unit;
+  num.placeholder = "whatever is free";
+  const unit = document.createElement("span");
+  unit.className = "bd-unit";
+  unit.textContent = descriptor.unit || "";
+
+  const read = () => {
+    const v = get();
+    return v === undefined || v === null ? descriptor.default : v;
+  };
+  const show = () => {
+    const v = read();
+    const auto = v === "auto";
+    box.checked = auto;
+    num.disabled = auto;
+    num.value = auto || v === undefined || v === null ? "" : String(v);
+  };
+  box.addEventListener("change", () => {
+    if (box.checked) set("auto");
+    else {
+      const floor = descriptor.minimum != null ? descriptor.minimum : 0;
+      set(Math.max(floor, Number(num.value) || floor));
+    }
+    show();
+  });
+  num.addEventListener("change", () => {
+    if (num.value === "") { set(descriptor.default === "auto" ? "auto" : undefined); show(); return; }
+    const n = parseFloat(num.value);
+    if (!Number.isFinite(n)) { show(); return; }
+    set(descriptor.minimum != null ? Math.max(descriptor.minimum, n) : n);
+    show();
+  });
+  wrap.append(boxLabel, num, unit);
+  show();
+  return wrap;
+}
+
+/**
+ * Build the control for one field block.
+ *
+ * @param {object} args
+ * @param {object} args.block       the block ({ref, ...})
+ * @param {object} args.descriptor  the field as /templates/modules describes it
+ * @param {object} args.siblings    the node's fields (for visible_when gates)
+ * @param {object} args.doc         the draft template document
+ * @param {(origin: string) => void} args.onChange  called after a value commit
+ * @param {(msg: string, kind?: string) => void} [args.onNote]
+ * @returns {{el: HTMLElement, refresh: () => void}}
+ */
+export function buildFieldControl({ block, descriptor, siblings, doc, onChange, onNote }) {
+  const ref = block.ref;
+  const holder = document.createElement("div");
+  holder.className = "bd-field";
+  const hint = document.createElement("div");
+  hint.className = "bd-hint";
+  hint.hidden = true;
+  const control = document.createElement("div");
+  control.className = "bd-control";
+  holder.append(control, hint);
+
+  const graphNode = ref.scope === "node"
+    ? ((doc.graph && doc.graph.nodes) || []).find((n) => n.id === ref.node)
+    : null;
+  const params = ref.scope === "node"
+    ? (graphNode ? (graphNode.params = graphNode.params || {}) : {})
+    : memoryParams(doc, { ...ref, name: ref.name });
+  const nodeLike = { params };
+  const get = () => getFieldValue(doc, ref);
+  const set = (v) => { if (setFieldValue(doc, ref, v)) onChange("value"); };
+
+  const refresh = () => {
+    if (descriptor.visible_when) {
+      const visible = rowVisible(nodeLike, descriptor, siblings);
+      holder.classList.toggle("is-inactive", !visible);
+      hint.hidden = visible;
+      const gate = descriptor.visible_when[0];
+      hint.textContent = visible ? "" : `not used with the current "${gate}" setting`;
+    }
+  };
+
+  const mount = () => {
+    let child;
+    if (descriptor.type === "bool" && !descriptor.choices) {
+      child = boolControl(descriptor, get, set);
+    } else if (descriptor.allow_auto) {
+      child = autoNumberControl(descriptor, get, set);
+    } else if (ref.scope === "graph") {
+      // A graph setting with a plain type: the stand-in node serves it.
+      child = buildWidget({
+        doc: { classOf: () => ({ inputs: [] }), changed: () => onChange("value") },
+        node: { params: memoryParams(doc, ref) },
+        port: { ...descriptor, name: ref.name }, origin: "page", onNote, onRebuild: mount,
+      });
+    } else {
+      child = buildWidget({
+        doc: {
+          classOf: () => ({ inputs: siblings }),
+          changed: () => { refresh(); onChange("value"); },
+        },
+        node: nodeLike, port: descriptor, origin: "page", onNote, onRebuild: () => { mount(); refresh(); },
+      });
+    }
+    control.replaceChildren(child);
+  };
+  mount();
+  refresh();
+  return { el: holder, refresh };
+}
diff --git a/frontend/js/board/layout.js b/frontend/js/board/layout.js
new file mode 100644
index 0000000..c22ed0a
--- /dev/null
+++ b/frontend/js/board/layout.js
@@ -0,0 +1,180 @@
+// @ts-check
+/* ---------------------------------------------------------------------------
+   board/layout.js -- the grid arithmetic of a template page. Pure: no DOM,
+   no I/O, nothing but numbers in and numbers out, which is why it is
+   unit-tested (frontend/tests/board_layout.test.mjs) instead of eyeballed.
+
+   A block is {id, x, y, w, h, collapsed?, ...}: a rectangle on a grid of
+   `columns` columns and unbounded rows. The rules are the usual dashboard
+   ones, chosen because people already have the muscle memory for them:
+
+     * blocks never overlap;
+     * moving or resizing a block pushes whatever is in its way DOWN;
+     * everything then settles upward (vertical compaction), so there are
+       no holes unless something is holding the space open;
+     * a collapsed block occupies a single row (its header) while it keeps
+       its stored `h`, so expanding it again restores what it was.
+
+   Every function returns NEW block objects; callers keep the old array as
+   an undo snapshot for free.
+
+   Determinism matters more than cleverness here: the same input must give
+   the same layout every time, or two people looking at one saved page see
+   two different pages. Ties are broken by (y, x, id).
+   --------------------------------------------------------------------------- */
+
+/** @typedef {{id: string, x: number, y: number, w: number, h: number, collapsed?: boolean}} Rect */
+
+/** Rows a block occupies right now (a collapsed block is just its header). */
+export function effH(b) {
+  return b.collapsed ? 1 : b.h;
+}
+
+/** Do two blocks overlap? Touching edges do not count. */
+export function collides(a, b) {
+  return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + effH(b) && b.y < a.y + effH(a);
+}
+
+/** Total order used everywhere a deterministic sequence is needed. */
+function byPosition(a, b) {
+  return a.y - b.y || a.x - b.x || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
+}
+
+/** Clamp one block onto the grid: integer, w in 1..columns, x so it fits,
+    y and h at least 0 / 1. Never throws -- a saved document from a wider
+    grid must still open on a narrower one. */
+export function clamp(b, columns) {
+  const w = Math.min(Math.max(1, Math.round(b.w) || 1), columns);
+  const x = Math.min(Math.max(0, Math.round(b.x) || 0), columns - w);
+  const y = Math.max(0, Math.round(b.y) || 0);
+  const h = Math.max(1, Math.round(b.h) || 1);
+  return { ...b, x, y, w, h };
+}
+
+/**
+ * Settle a layout.
+ *
+ * `pinnedId` (optional) is the block the user is holding: it keeps its
+ * requested position and everything else arranges itself around it. Without
+ * one, blocks are placed in reading order.
+ *
+ * @param {Rect[]} blocks
+ * @param {number} columns
+ * @param {string|null} [pinnedId]
+ * @returns {Rect[]} in the input's order
+ */
+export function resolve(blocks, columns, pinnedId = null) {
+  const clamped = blocks.map((b) => clamp(b, columns));
+  /** @type {Map<string, Rect>} */
+  const out = new Map();
+  /** @type {Rect[]} */
+  const placed = [];
+
+  const place = (b) => {
+    // The lowest y at which b clears everything already placed. Starting
+    // from 0 is what makes this compaction; each collision jumps straight
+    // to the bottom of the offender instead of stepping row by row.
+    let y = 0;
+    for (;;) {
+      const probe = { ...b, y };
+      const hit = placed.find((p) => collides(probe, p));
+      if (!hit) break;
+      y = hit.y + effH(hit);
+    }
+    const settled = { ...b, y };
+    placed.push(settled);
+    out.set(b.id, settled);
+  };
+
+  const pinned = pinnedId === null ? null : clamped.find((b) => b.id === pinnedId);
+  if (pinned) {
+    // The held block goes down exactly where requested (not compacted):
+    // the user is pointing at a spot, and sliding it up would make the
+    // drop land somewhere they did not choose.
+    placed.push(pinned);
+    out.set(pinned.id, pinned);
+  }
+  for (const b of clamped.filter((b) => b !== pinned).sort(byPosition)) place(b);
+  return blocks.map((b) => /** @type {Rect} */ (out.get(b.id)));
+}
+
+/** Move a block to (x, y); the rest make way. */
+export function moveTo(blocks, id, x, y, columns) {
+  const next = blocks.map((b) => (b.id === id ? { ...b, x, y } : b));
+  return resolve(next, columns, id);
+}
+
+/** Resize a block (w, h in grid units); the rest make way. */
+export function resizeTo(blocks, id, w, h, columns) {
+  const next = blocks.map((b) => (b.id === id ? { ...b, w, h } : b));
+  return resolve(next, columns, id);
+}
+
+/** Collapse / expand a block, then let the rest settle. */
+export function setCollapsed(blocks, id, collapsed, columns) {
+  return resolve(blocks.map((b) => (b.id === id ? { ...b, collapsed } : b)), columns);
+}
+
+/**
+ * First place a new w x h block fits, scanning rows top to bottom and
+ * columns left to right -- so a new field drops into a gap if there is
+ * one, and at the bottom if there is not.
+ */
+export function findFreeSlot(blocks, w, h, columns) {
+  const width = Math.min(Math.max(1, w), columns);
+  const bottom = blocks.reduce((m, b) => Math.max(m, b.y + effH(b)), 0);
+  for (let y = 0; y <= bottom; y++) {
+    for (let x = 0; x + width <= columns; x++) {
+      const probe = { id: "", x, y, w: width, h, collapsed: false };
+      if (!blocks.some((b) => collides(probe, b))) return { x, y };
+    }
+  }
+  return { x: 0, y: bottom };
+}
+
+/** Append `block` (its x/y are ignored) at the first free slot. */
+export function addAt(blocks, block, columns) {
+  const w = Math.min(Math.max(1, block.w), columns);
+  const { x, y } = findFreeSlot(blocks, w, block.h, columns);
+  return resolve([...blocks, { ...block, w, x, y }], columns);
+}
+
+/** Reading order -- what a one-column (phone) layout stacks in. */
+export function flowOrder(blocks) {
+  return [...blocks].sort(byPosition);
+}
+
+/** Rows the whole layout spans (for sizing the container). */
+export function totalRows(blocks) {
+  return blocks.reduce((m, b) => Math.max(m, b.y + effH(b)), 0);
+}
+
+/**
+ * Which grid cell is a pixel offset in? Used by drag and resize: the
+ * pointer moved (dx, dy) px from where it started and a cell is
+ * (colW + gap) x (rowH + gap) px.
+ */
+export function cellDelta(dx, dy, colW, rowH, gap) {
+  return {
+    dCols: Math.round(dx / (colW + gap)),
+    dRows: Math.round(dy / (rowH + gap)),
+  };
+}
+
+/** Pixel width of one column for a container `width` px wide. */
+export function columnWidth(width, columns, gap) {
+  return Math.max(1, (width - gap * (columns - 1)) / columns);
+}
+
+/**
+ * Keyboard moves: arrows move by one cell, shift+arrows resize. Returns
+ * the new layout, or the same array when the key means nothing here.
+ */
+export function keyNudge(blocks, id, key, shift, columns) {
+  const b = blocks.find((x) => x.id === id);
+  if (!b) return blocks;
+  const step = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[key];
+  if (!step) return blocks;
+  if (shift) return resizeTo(blocks, id, b.w + step[0], Math.max(1, b.h + step[1]), columns);
+  return moveTo(blocks, id, b.x + step[0], Math.max(0, b.y + step[1]), columns);
+}
diff --git a/frontend/js/board/live.js b/frontend/js/board/live.js
new file mode 100644
index 0000000..4f3c3bb
--- /dev/null
+++ b/frontend/js/board/live.js
@@ -0,0 +1,75 @@
+/* ---------------------------------------------------------------------------
+   board/live.js -- one connection per stream, shared by every block on it.
+
+   `LiveStreams.acquire(id, onChange)` opens `/api/v1/monitor/<id>/stream` the
+   first time anyone wants it, hands back the shared `StreamState`, and closes
+   the connection when the last block lets go. Blocks never hold sockets, so
+   collapsing, removing or re-adding one costs nothing and a page with five
+   views of one trainer opens one connection, not five.
+
+   `onChange(id)` is called after every frame that changed state; the board
+   coalesces those into at most one redraw per animation frame.
+
+   The EventSource is injectable so the lifecycle is testable without a
+   browser (frontend/tests/board_live.test.mjs).
+   --------------------------------------------------------------------------- */
+
+import { StreamState } from "./series.js";
+
+const defaultOpen = (id, handlers) => {
+  const source = new EventSource(`/api/v1/monitor/${encodeURIComponent(id)}/stream`);
+  source.onmessage = handlers.onMessage;
+  source.onerror = handlers.onError;
+  return source;
+};
+
+export class LiveStreams {
+  /** @param {{open?: Function, now?: () => number}} [opts] */
+  constructor({ open = defaultOpen, now = () => Date.now() } = {}) {
+    this._open = open;
+    this._now = now;
+    this._streams = new Map(); // id -> {state, source, listeners:Set}
+  }
+
+  /** Connect (or join) a stream. Returns `{state, release}`. */
+  acquire(id, onChange) {
+    let entry = this._streams.get(id);
+    if (!entry) {
+      const state = new StreamState();
+      entry = { state, source: null, listeners: new Set() };
+      this._streams.set(id, entry);
+      const notify = () => entry.listeners.forEach((fn) => fn(id));
+      entry.source = this._open(id, {
+        onMessage: (ev) => {
+          const r = state.applyRaw(ev.data, this._now());
+          if (r.kind !== "ignored") notify();
+        },
+        onError: () => { state.setConn("disconnected"); notify(); },
+      });
+    }
+    entry.listeners.add(onChange);
+    let released = false;
+    return {
+      state: entry.state,
+      release: () => {
+        if (released) return;
+        released = true;
+        entry.listeners.delete(onChange);
+        if (entry.listeners.size === 0) {
+          try { entry.source.close(); } catch { /* already closed */ }
+          this._streams.delete(id);
+        }
+      },
+    };
+  }
+
+  /** Streams currently open (for tests and the page's connection line). */
+  get openIds() { return [...this._streams.keys()]; }
+
+  closeAll() {
+    for (const entry of this._streams.values()) {
+      try { entry.source.close(); } catch { /* already closed */ }
+    }
+    this._streams.clear();
+  }
+}
diff --git a/frontend/js/board/model.js b/frontend/js/board/model.js
new file mode 100644
index 0000000..b5a2980
--- /dev/null
+++ b/frontend/js/board/model.js
@@ -0,0 +1,357 @@
+/* ---------------------------------------------------------------------------
+   board/model.js -- the template document, as pure functions.
+
+   A template document (backend/domain/template.py) is a board of *blocks*
+   plus a snapshot of the graph they belong to:
+
+     {format, kind: "template"|"monitor", columns, source_graph, graph,
+      blocks: [{id, ref: {scope: "node"|"graph", node?, kind: "field"|
+                "display", name}, x, y, w, h, collapsed, title, options}]}
+
+   Nothing in this file touches the DOM, the network or a clock, so every
+   rule a person relies on -- "what can I add", "which fields does the
+   starter page expose", "what exactly will Run send" -- is checked by
+   number in frontend/tests/board_model.test.mjs.
+
+   The *modules* argument is what the backend's POST /templates/modules
+   returns: {nodes: [{id, class_name, display_name, known, fields,
+   displays, stream}], graph_fields, graph_displays}. The backend, not this
+   file, decides what a node offers; this file only arranges it.
+   --------------------------------------------------------------------------- */
+
+import { addAt, resolve } from "./layout.js";
+
+export const GRAPH_STREAM = "graph:run";
+
+/* ---- identity ------------------------------------------------------------ */
+
+/** A stable string for a block's target: used as the "is it placed" key. */
+export function refKey(ref) {
+  return ref.scope === "graph"
+    ? `graph/${ref.kind}/${ref.name}`
+    : `node/${ref.node}/${ref.kind}/${ref.name}`;
+}
+
+export const nodeRef = (node, kind, name) => ({ scope: "node", node, kind, name });
+export const graphRef = (kind, name) => ({ scope: "graph", kind, name });
+
+/** A block id not used in `blocks` (ids are [A-Za-z0-9_-]{1,40}). */
+export function newBlockId(blocks) {
+  const used = new Set(blocks.map((b) => b.id));
+  let n = blocks.length + 1;
+  while (used.has(`b${n}`)) n++;
+  return `b${n}`;
+}
+
+export function emptyDoc(kind, graph = null, columns = 12) {
+  return {
+    format: 1, kind, columns, source_graph: null,
+    graph: kind === "template" ? (graph || { nodes: [], edges: [] }) : graph,
+    blocks: [],
+  };
+}
+
+/* ---- finding what a block points at ------------------------------------- */
+
+/** `{node, descriptor}` for a ref against the modules answer. `descriptor`
+    is null when the target is gone; `node` is null for graph scope. */
+export function findTarget(ref, modules) {
+  if (!modules) return { node: null, descriptor: null };
+  if (ref.scope === "graph") {
+    const list = ref.kind === "field" ? modules.graph_fields : modules.graph_displays;
+    return { node: null, descriptor: (list || []).find((d) => d.name === ref.name) || null };
+  }
+  const node = (modules.nodes || []).find((n) => n.id === ref.node) || null;
+  if (!node) return { node: null, descriptor: null };
+  const list = ref.kind === "field" ? node.fields : node.displays;
+  return { node, descriptor: (list || []).find((d) => d.name === ref.name) || null };
+}
+
+/** Heading and sub-heading of a block. A saved custom title wins. */
+export function titleFor(block, modules) {
+  const { node, descriptor } = findTarget(block.ref, modules);
+  const base = descriptor
+    ? descriptor.label || descriptor.title || descriptor.name
+    : block.ref.name;
+  const where = block.ref.scope === "graph"
+    ? "Graph"
+    : node ? `${node.display_name} · ${node.id}` : block.ref.node;
+  // A node's live view shares its name with the setting it displays
+  // ("Learning rate"); say which one this is.
+  const live = block.ref.kind === "display" && block.ref.scope === "node" ? " \u00b7 live view" : "";
+  return { title: block.title || base, subtitle: where + live, defaultTitle: base };
+}
+
+/* ---- sizes --------------------------------------------------------------- */
+
+const JSON_TYPES = new Set(["list", "dict", "tuple"]);
+
+/** Suggested [w, h] for a new block, in grid units, clamped to `columns`. */
+export function defaultSize(ref, modules, columns) {
+  const { descriptor } = findTarget(ref, modules);
+  let w = 4, h = 2;
+  if (ref.kind === "display") {
+    const size = descriptor && Array.isArray(descriptor.size) ? descriptor.size : [6, 4];
+    [w, h] = size;
+  } else if (descriptor) {
+    if (JSON_TYPES.has(descriptor.type)) h = 3;
+  }
+  if (columns < 8) w = columns;
+  return [Math.max(1, Math.min(w, columns)), Math.max(1, h)];
+}
+
+/* ---- the "what can I add" tray ------------------------------------------ */
+
+/**
+ * Groups of things the graph offers, each item flagged `placed` when the
+ * document already shows it. A field the graph feeds from upstream is not
+ * offered at all (nothing to type into it); advanced fields are offered
+ * only when `showAdvanced`, except that an already-placed one always
+ * appears so it can be found again.
+ *
+ * @returns {{key: string, title: string, scope: string, items: object[]}[]}
+ */
+export function buildAvailable(modules, blocks, { showAdvanced = false } = {}) {
+  if (!modules) return [];
+  const placed = new Set(blocks.map((b) => refKey(b.ref)));
+  const item = (ref, label, sub, extra = {}) => ({
+    ref, key: refKey(ref), label, sub, placed: placed.has(refKey(ref)),
+    kind: ref.kind, advanced: false, ...extra,
+  });
+  const keep = (it) => it.placed || showAdvanced || !it.advanced;
+
+  const groups = [];
+
+  const graphItems = [
+    ...(modules.graph_displays || []).map((d) =>
+      item(graphRef("display", d.name), d.title, d.doc || "")),
+    ...(modules.graph_fields || []).map((f) =>
+      item(graphRef("field", f.name), f.label || f.name, f.doc || "",
+        { advanced: !!f.advanced, group: f.group || "" })),
+  ].filter(keep);
+  if (graphItems.length) {
+    groups.push({ key: "graph", title: "This graph", scope: "graph", items: graphItems });
+  }
+
+  for (const node of modules.nodes || []) {
+    if (!node.known) continue;
+    const items = [
+      ...node.displays.map((d) =>
+        item(nodeRef(node.id, "display", d.name), d.title, d.doc || "")),
+      ...node.fields
+        .filter((f) => !f.wired)
+        .map((f) =>
+          item(nodeRef(node.id, "field", f.name), f.label || f.name, f.doc || "",
+            { advanced: !!f.advanced, group: f.group || "", type: f.type })),
+    ].filter(keep);
+    if (items.length) {
+      groups.push({
+        key: `node:${node.id}`, title: `${node.display_name} · ${node.id}`,
+        scope: "node", items,
+      });
+    }
+  }
+  return groups;
+}
+
+/* ---- adding / removing blocks ------------------------------------------- */
+
+/** The document with a new block for `ref` at the first free slot
+    (a no-op, returning the same doc, when the ref is already placed). */
+export function addBlock(doc, ref, modules) {
+  const key = refKey(ref);
+  if (doc.blocks.some((b) => refKey(b.ref) === key)) return doc;
+  const [w, h] = defaultSize(ref, modules, doc.columns);
+  const block = {
+    id: newBlockId(doc.blocks), ref, x: 0, y: 0, w, h,
+    collapsed: false, title: null, options: {},
+  };
+  return { ...doc, blocks: addAt(doc.blocks, block, doc.columns) };
+}
+
+export function removeBlock(doc, id) {
+  return { ...doc, blocks: resolve(doc.blocks.filter((b) => b.id !== id), doc.columns) };
+}
+
+export function patchBlock(doc, id, patch) {
+  return { ...doc, blocks: doc.blocks.map((b) => (b.id === id ? { ...b, ...patch } : b)) };
+}
+
+/* ---- the starter page --------------------------------------------------- */
+
+/**
+ * A first page for a graph, so "new from this graph" is not a blank board.
+ *
+ * Exposed: the fields the graph's author actually set (or that cannot run
+ * without a value), skipping advanced and wired ones, capped at
+ * `maxFields` so a big graph does not become a wall of inputs -- plus the
+ * graph's VRAM budget. Shown: every live view the nodes declare, the run
+ * status and the memory chart. Fields stack on the left, live views on the
+ * right; the person rearranges it in edit mode.
+ *
+ * Deliberately a heuristic and a *starting point*: it cannot know which
+ * knobs a beginner should see. Everything it leaves out is one click away
+ * in the tray.
+ */
+export function autoFill(modules, columns = 12, { maxFields = 16 } = {}) {
+  const narrow = columns < 8;
+  const leftW = narrow ? columns : Math.max(3, Math.round(columns / 3));
+  const rightW = narrow ? columns : columns - leftW;
+  const rightX = narrow ? 0 : leftW;
+
+  const fieldRefs = [];
+  const graphBudget = (modules.graph_fields || []).find((f) => f.name === "memory.vram_max_mb");
+  if (graphBudget) fieldRefs.push(graphRef("field", graphBudget.name));
+  let nodeFieldCount = 0;
+  for (const node of modules.nodes || []) {
+    if (!node.known) continue;
+    for (const f of node.fields) {
+      if (nodeFieldCount >= maxFields) break;
+      if (f.wired || f.advanced) continue;
+      const needed = f.required && (f.default === null || f.default === undefined);
+      if (f.has_value || needed) {
+        fieldRefs.push(nodeRef(node.id, "field", f.name));
+        nodeFieldCount++;
+      }
+    }
+  }
+
+  const displayRefs = [graphRef("display", "run")];
+  for (const node of modules.nodes || []) {
+    if (!node.known) continue;
+    for (const d of node.displays) displayRefs.push(nodeRef(node.id, "display", d.name));
+  }
+  if ((modules.graph_displays || []).some((d) => d.name === "memory")) {
+    displayRefs.push(graphRef("display", "memory"));
+  }
+
+  const blocks = [];
+  let yLeft = 0;
+  for (const ref of fieldRefs) {
+    const [, h] = defaultSize(ref, modules, columns);
+    blocks.push({
+      id: `b${blocks.length + 1}`, ref, x: 0, y: yLeft, w: leftW, h,
+      collapsed: false, title: null, options: {},
+    });
+    yLeft += h;
+  }
+  let yRight = narrow ? yLeft : 0;
+  for (const ref of displayRefs) {
+    const [w, h] = defaultSize(ref, modules, columns);
+    const bw = Math.min(w, rightW);
+    blocks.push({
+      id: `b${blocks.length + 1}`, ref, x: rightX, y: yRight, w: bw, h,
+      collapsed: false, title: null, options: {},
+    });
+    yRight += h;
+  }
+  return resolve(blocks, columns);
+}
+
+/* ---- values: the draft graph is where a field's value lives ------------- */
+
+function nodeOf(doc, id) {
+  return ((doc.graph && doc.graph.nodes) || []).find((n) => n.id === id) || null;
+}
+
+/** Current value of a field block's target in the draft graph, or
+    `undefined` when unset (the node's default applies). */
+export function getFieldValue(doc, ref) {
+  if (ref.scope === "graph") {
+    const key = ref.name.split(".", 2)[1];
+    const mem = (doc.graph && doc.graph.memory) || {};
+    return mem[key];
+  }
+  const node = nodeOf(doc, ref.node);
+  return node && node.params ? node.params[ref.name] : undefined;
+}
+
+/** Set (or, for undefined/null/"", clear) a field in the draft graph.
+    Mutates `doc.graph` in place -- the page owns its draft -- and returns
+    whether anything changed. */
+export function setFieldValue(doc, ref, value) {
+  const clear = value === undefined || value === null || value === "";
+  const before = getFieldValue(doc, ref);
+  if (ref.scope === "graph") {
+    const key = ref.name.split(".", 2)[1];
+    if (!doc.graph) doc.graph = { nodes: [], edges: [] };
+    const mem = (doc.graph.memory = doc.graph.memory || {});
+    if (clear) delete mem[key];
+    else mem[key] = value;
+  } else {
+    const node = nodeOf(doc, ref.node);
+    if (!node) return false;
+    node.params = node.params || {};
+    if (clear) delete node.params[ref.name];
+    else node.params[ref.name] = value;
+  }
+  return JSON.stringify(before) !== JSON.stringify(getFieldValue(doc, ref));
+}
+
+/**
+ * The `values` body of POST /templates/{name}/run: the current value of
+ * every field block the page places. A cleared field is sent as null so the
+ * server clears it too (the saved graph may hold a value the person just
+ * emptied); a graph-memory field that is unset is left out, because the
+ * server merges memory settings rather than clearing them.
+ *
+ * `statuses` (block id -> status from /resolve) filters out blocks the
+ * server would refuse: wired fields and orphans.
+ */
+export function valuesPayload(doc, statuses = {}) {
+  const nodes = {};
+  const memory = {};
+  for (const b of doc.blocks) {
+    if (b.ref.kind !== "field") continue;
+    const st = statuses[b.id];
+    if (st && st !== "ok") continue;
+    const v = getFieldValue(doc, b.ref);
+    if (b.ref.scope === "graph") {
+      if (v !== undefined) memory[b.ref.name.split(".", 2)[1]] = v;
+    } else {
+      (nodes[b.ref.node] = nodes[b.ref.node] || {})[b.ref.name] = v === undefined ? null : v;
+    }
+  }
+  const out = {};
+  if (Object.keys(nodes).length) out.nodes = nodes;
+  if (Object.keys(memory).length) out.memory = memory;
+  return out;
+}
+
+/* ---- dirty detection ----------------------------------------------------- */
+
+/** What "layout" means for unsaved-changes purposes: where blocks are and
+    how they are labelled -- not their live data. */
+export function layoutKey(doc) {
+  return JSON.stringify({
+    c: doc.columns,
+    b: doc.blocks.map((b) => [
+      b.id, refKey(b.ref), b.x, b.y, b.w, b.h, !!b.collapsed, b.title || null,
+      b.options || {},
+    ]),
+  });
+}
+
+export function graphKey(doc) {
+  return JSON.stringify(doc.graph || null);
+}
+
+export const docKey = (doc) => `${layoutKey(doc)}|${graphKey(doc)}`;
+
+/** The document as it should be PUT: format stamped, nothing live in it. */
+export function toSaveDoc(doc) {
+  return {
+    ...doc,
+    format: 1,
+    blocks: doc.blocks.map((b) => ({
+      ...b, collapsed: !!b.collapsed, title: b.title || null, options: b.options || {},
+    })),
+  };
+}
+
+/** block id -> status string from a /resolve answer. */
+export function statusByBlock(resolution) {
+  const out = {};
+  for (const b of (resolution && resolution.blocks) || []) out[b.id] = b.status;
+  return out;
+}
diff --git a/frontend/js/board/series.js b/frontend/js/board/series.js
new file mode 100644
index 0000000..43477a1
--- /dev/null
+++ b/frontend/js/board/series.js
@@ -0,0 +1,320 @@
+/* ---------------------------------------------------------------------------
+   board/series.js -- live data for display blocks, as pure functions.
+
+   A *stream* is one monitor-bus id (`node:<id>` or `graph:run`). Several
+   blocks may watch the same stream (a node's loss chart, learning-rate chart
+   and progress bar all read `node:trainer`), so the data lives in one
+   `StreamState` per id and each block *derives* what it draws from it --
+   nothing is plotted twice and nothing is kept per block.
+
+   Frame contract (same as the old monitor page, backend/presentation/api/
+   monitor.py): `{"type":"connected"}`, raw step reports (a dict with `step`,
+   or `t` for graph-scope streams), `{"type":"clear"}`, `{"type":"run_end",
+   step, cancelled}`. A frame with some other `type`, or with no x at all, is
+   not telemetry and is ignored rather than plotted as a hole.
+
+   Two rules carried over from the dashboard because they are the ones that
+   stop a chart lying:
+     * a key absent from a report is a **gap**, never zero;
+     * a non-finite number (the server sends null + a marker) is a gap too.
+
+   No DOM, no EventSource, no real clock: `applyFrame` takes the arrival time
+   so tests drive it, and `decimate`/`progressOf` are plain functions.
+   --------------------------------------------------------------------------- */
+
+/** Series colours for keys discovered at run time (stable per key). */
+export const PALETTE = [
+  "#6c8cff", "#4caf50", "#ff9800", "#e0577d", "#26c6da",
+  "#ab47bc", "#d4e157", "#8d6e63", "#78909c", "#ffca28",
+];
+
+const num = (v) => (typeof v === "number" && Number.isFinite(v) ? v : null);
+
+/* ---- one stream's state -------------------------------------------------- */
+
+export class StreamState {
+  /** @param {{maxRows?: number}} [opts] rows kept (oldest dropped past it) */
+  constructor({ maxRows = 50000 } = {}) {
+    this.maxRows = maxRows;
+    this.reset();
+    this.conn = "connecting"; // connecting | live | disconnected
+    this.bad = 0; // frames that were not JSON
+  }
+
+  /** What a `clear` frame does: forget the run, keep the connection. */
+  reset() {
+    this.rows = [];      // [{frame, at}]  at = arrival ms
+    this.dropped = 0;    // rows discarded to stay under maxRows
+    this.last = {};      // key -> {value, x}: latest present value (gap-proof)
+    this.keys = new Set();  // numeric keys seen, in first-seen order
+    this.t0 = null;      // first `t` after a clear: x=t is shown relative to it
+    this.runEnd = null;  // null while running, {step, cancelled} after run_end
+    this.latestFrame = null;
+  }
+
+  /** Parse and apply one SSE `data` string. Never throws. */
+  applyRaw(text, at = 0) {
+    let frame;
+    try { frame = JSON.parse(text); } catch { this.bad++; return { kind: "bad" }; }
+    return this.applyFrame(frame, at);
+  }
+
+  applyFrame(frame, at = 0) {
+    if (frame === null || typeof frame !== "object" || Array.isArray(frame)) {
+      this.bad++;
+      return { kind: "bad" };
+    }
+    if (frame.type === "connected") {
+      // The server sends this at the start of EVERY (re)connect and then
+      // replays the stream's history (state frames included), so whatever
+      // is held now would be delivered a second time: start from empty.
+      this.reset();
+      this.conn = "live";
+      return { kind: "connected" };
+    }
+    if (frame.type === "clear") { this.reset(); return { kind: "clear" }; }
+    if (frame.type === "run_end") {
+      this.runEnd = { step: frame.step ?? null, cancelled: !!frame.cancelled };
+      return { kind: "run_end" };
+    }
+    if (frame.type !== undefined) return { kind: "ignored" };
+    if (num(frame.step) === null && num(frame.t) === null) return { kind: "ignored" };
+
+    if (this.runEnd) this.runEnd = null; // a new report after run_end: new run
+    if (this.t0 === null && num(frame.t) !== null) this.t0 = frame.t;
+    this.rows.push({ frame, at });
+    if (this.rows.length > this.maxRows) {
+      const cut = this.rows.length - this.maxRows;
+      this.rows.splice(0, cut);
+      this.dropped += cut;
+    }
+    this.latestFrame = frame;
+    const x = { step: frame.step, t: this.t0 === null ? null : frame.t - this.t0 };
+    for (const [key, value] of Object.entries(frame)) {
+      const n = num(value);
+      if (n !== null) {
+        this.keys.add(key);
+        this.last[key] = { value: n, x };
+      } else if (typeof value === "string") {
+        this.last[key] = { value, x };
+      }
+    }
+    return { kind: "point" };
+  }
+
+  setConn(state) { this.conn = state; }
+}
+
+/* ---- x axis -------------------------------------------------------------- */
+
+/** x of a frame for a module: the step, or seconds since the run began. */
+export function xOf(state, frame, xKey) {
+  if (xKey === "t") {
+    const t = num(frame.t);
+    return t === null || state.t0 === null ? null : t - state.t0;
+  }
+  return num(frame.step);
+}
+
+/* ---- series discovery ---------------------------------------------------- */
+
+/** Shell-style glob (`*`, `?`, `[abc]`) as the backend's `pattern` means it
+    (Python `fnmatch`). Case-sensitive. */
+export function globToRegExp(pattern) {
+  let out = "";
+  for (let i = 0; i < pattern.length; i++) {
+    const c = pattern[i];
+    if (c === "*") out += ".*";
+    else if (c === "?") out += ".";
+    else if (c === "[") {
+      const end = pattern.indexOf("]", i + 2);
+      if (end === -1) out += "\\[";
+      else {
+        let body = pattern.slice(i + 1, end);
+        if (body[0] === "!") body = "^" + body.slice(1);
+        out += `[${body.replace(/\\/g, "\\\\")}]`;
+        i = end;
+      }
+    } else out += c.replace(/[.+^${}()|\\/]/g, "\\$&");
+  }
+  return new RegExp(`^${out}$`);
+}
+
+/** Pretty label for a discovered key (`fwd_ms` -> `fwd`). */
+export function labelFromKey(key) {
+  return key.replace(/_ms$/, "").replace(/_mb$/, "").replace(/_/g, " ");
+}
+
+/**
+ * The series a module draws right now: its declared ones, plus -- when it
+ * has a `pattern` -- every numeric key the stream has shown that matches and
+ * is not excluded. Discovered colours come from `PALETTE` by the key's
+ * position in the stream's first-seen order, so a series keeps its colour
+ * for the whole run however many appear later.
+ */
+export function seriesFor(module, state) {
+  const out = (module.series || []).map((s) => ({ ...s, label: s.label || s.key }));
+  const have = new Set(out.map((s) => s.key));
+  if (module.pattern) {
+    const re = globToRegExp(module.pattern);
+    const excluded = new Set(module.exclude || []);
+    let i = 0;
+    for (const key of state.keys) {
+      if (re.test(key) && !excluded.has(key) && !have.has(key)) {
+        out.push({
+          key, label: labelFromKey(key),
+          color: PALETTE[(i + out.length) % PALETTE.length], unit: "",
+        });
+        have.add(key);
+      }
+      i++;
+    }
+  }
+  return out.map((s, idx) => ({ ...s, color: s.color || PALETTE[idx % PALETTE.length] }));
+}
+
+/* ---- chart rows ---------------------------------------------------------- */
+
+/** `[{x, values: {key: number|null}}]` for the chart, one per frame that has
+    an x. `keys` limits which series are copied. */
+export function chartRows(state, module, keys) {
+  const rows = [];
+  for (const { frame } of state.rows) {
+    const x = xOf(state, frame, module.x || "step");
+    if (x === null) continue;
+    const values = {};
+    for (const k of keys) values[k] = num(frame[k]);
+    rows.push({ x, values });
+  }
+  return rows;
+}
+
+/**
+ * Cut `rows` to about `maxRows` for drawing while keeping what a reader
+ * looks for: in each bucket of consecutive rows, the row holding each
+ * series' minimum and the row holding its maximum survive, so a one-step
+ * loss spike is still in the picture; the first and last rows always do
+ * (the newest point is where the eye goes). Kept rows are *original* rows,
+ * in order -- no averaging, no invented values.
+ */
+export function decimate(rows, maxRows, keys) {
+  if (rows.length <= maxRows || maxRows < 4) return rows;
+  const k = Math.max(1, keys.length);
+  const buckets = Math.max(1, Math.floor((maxRows - 2) / (2 * k)));
+  const size = rows.length / buckets;
+  const keep = new Set([0, rows.length - 1]);
+  for (let b = 0; b < buckets; b++) {
+    const from = Math.floor(b * size);
+    const to = Math.min(rows.length, Math.floor((b + 1) * size));
+    for (const key of keys) {
+      let lo = -1, hi = -1;
+      for (let i = from; i < to; i++) {
+        const v = rows[i].values[key];
+        if (v === null || v === undefined) continue;
+        if (lo < 0 || v < rows[lo].values[key]) lo = i;
+        if (hi < 0 || v > rows[hi].values[key]) hi = i;
+      }
+      if (lo >= 0) { keep.add(lo); keep.add(hi); }
+    }
+  }
+  return [...keep].sort((a, b) => a - b).map((i) => rows[i]);
+}
+
+/** Reference lines: the latest value of `reference_key`, if the stream has
+    shown one. */
+export function referenceLines(module, state) {
+  if (!module.reference_key) return [];
+  const last = state.last[module.reference_key];
+  if (!last || typeof last.value !== "number") return [];
+  return [{ value: last.value, label: labelFromKey(module.reference_key), color: "#ff9800" }];
+}
+
+/* ---- latest-value kinds -------------------------------------------------- */
+
+/** scalar: the newest present value of the module's first series, with how
+    old it is -- `stale` when the newest frame did not carry it. */
+export function scalarOf(module, state) {
+  const series = seriesFor(module, state)[0];
+  if (!series) return null;
+  const last = state.last[series.key];
+  if (!last || typeof last.value !== "number") return null;
+  const newest = state.latestFrame;
+  const stale = !newest || num(newest[series.key]) === null;
+  return { series, value: last.value, x: last.x, stale };
+}
+
+/** bars: every series' newest present value, in series order. */
+export function barsOf(module, state) {
+  return seriesFor(module, state)
+    .map((s) => {
+      const last = state.last[s.key];
+      return last && typeof last.value === "number" ? { ...s, value: last.value } : null;
+    })
+    .filter(Boolean);
+}
+
+export function textOf(module, state) {
+  const series = (module.series || [])[0];
+  if (!series) return null;
+  const last = state.last[series.key];
+  return last === undefined ? null : String(last.value);
+}
+
+/**
+ * progress: `value` of `total` with a rate and an ETA from the last few
+ * reports' arrival times (`window` rows). Rate is steps per second of
+ * *wall-clock*, because that is what the person waits in; the ETA is null
+ * until there are two reports at least a second apart, or when the run is
+ * not advancing -- never a guess from one sample.
+ */
+export function progressOf(module, state, { window = 20 } = {}) {
+  const vk = module.value_key, tk = module.total_key;
+  const v = state.last[vk], t = state.last[tk];
+  if (!v || typeof v.value !== "number") return null;
+  const total = t && typeof t.value === "number" && t.value > 0 ? t.value : null;
+  const out = {
+    value: v.value, total,
+    fraction: total ? Math.min(1, v.value / total) : null,
+    rate: null, eta: null,
+    done: !!state.runEnd,
+  };
+  const recent = state.rows
+    .filter((r) => num(r.frame[vk]) !== null)
+    .slice(-window);
+  if (recent.length >= 2) {
+    const a = recent[0], b = recent[recent.length - 1];
+    const dt = (b.at - a.at) / 1000;
+    const dv = b.frame[vk] - a.frame[vk];
+    // Under a second apart means the reports arrived in a burst -- a page
+    // opened late is replayed the whole history at once -- and a rate from
+    // that would be nonsense ("19000/s"), so there is none.
+    if (dt >= 1 && dv > 0) {
+      out.rate = dv / dt;
+      if (total && !out.done) out.eta = Math.max(0, (total - v.value) / out.rate);
+    }
+  }
+  return out;
+}
+
+/** "1h 02m", "4m 05s", "12s" -- for an ETA or an elapsed time. */
+export function formatDuration(seconds) {
+  if (seconds === null || seconds === undefined || !Number.isFinite(seconds)) return "—";
+  const s = Math.max(0, Math.round(seconds));
+  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
+  if (h) return `${h}h ${String(m).padStart(2, "0")}m`;
+  if (m) return `${m}m ${String(r).padStart(2, "0")}s`;
+  return `${r}s`;
+}
+
+/** A readable number for a scalar: integers plain, big values with
+    separators, small ones to 4 significant digits. */
+export function formatValue(v) {
+  if (v === null || v === undefined || !Number.isFinite(v)) return "—";
+  const a = Math.abs(v);
+  if (Number.isInteger(v)) return v.toLocaleString("en-US");
+  if (a >= 100) return v.toFixed(1);
+  if (a >= 10) return v.toFixed(2);
+  if (a >= 1) return v.toFixed(3);
+  if (a === 0) return "0";
+  return v.toPrecision(3);
+}
