+
+.bd-bars { display: flex; flex-direction: column; gap: 6px; justify-content: center; height: 100%; }
+.bd-bar-row { display: grid; grid-template-columns: minmax(48px, 22%) 1fr minmax(56px, auto); gap: 8px; align-items: center; font-size: 12px; }
+.bd-bar-label { color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.bd-bar-track { height: 10px; background: var(--bg); border-radius: 5px; overflow: hidden; }
+.bd-bar-fill { height: 100%; border-radius: 5px; transition: width var(--dur-med) ease; }
+.bd-bar-value { text-align: right; font-variant-numeric: tabular-nums; }
+
+.bd-text { font-family: var(--font-mono); font-size: 12.5px; white-space: pre-wrap; overflow-wrap: anywhere; }
+
+.bd-progress { display: flex; flex-direction: column; justify-content: center; height: 100%; gap: 8px; }
+.bd-progress-head { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; font-variant-numeric: tabular-nums; }
+.bd-progress-eta { color: var(--text-dim); }
+.bd-progress-track { height: 12px; background: var(--bg); border-radius: 6px; overflow: hidden; border: 1px solid var(--border); }
+.bd-progress-fill { height: 100%; background: var(--accent); transition: width var(--dur-med) ease; }
+.bd-progress.is-done .bd-progress-fill { background: var(--green); }
+
+.bd-status { display: flex; flex-direction: column; gap: 6px; justify-content: center; height: 100%; }
+.bd-status .status-badge { margin-top: 0; }
+.bd-status-line { color: var(--text-dim); font-size: 12.5px; font-variant-numeric: tabular-nums; }
+.bd-status-error { color: var(--red); font-size: 12px; white-space: pre-wrap; overflow-wrap: anywhere; }
+
+/* ---- 5. tray ---- */
+
+.tpl-tray {
+    width: 290px; flex: none; position: sticky; top: 56px; max-height: calc(100vh - 140px);
+    display: flex; flex-direction: column; gap: 8px; padding: 12px;
+    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
+}
+.tpl-tray[hidden] { display: none; }
+.tpl-tray-head { display: flex; justify-content: space-between; align-items: center; font-size: 13px; }
+.tpl-adv { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-dim); cursor: pointer; }
+.tpl-adv input { width: 1.1rem; height: 1.1rem; }
+#tray-search { padding: 0.45rem 0.6rem; font-size: 13px; }
+#tray-list { overflow-y: auto; display: flex; flex-direction: column; gap: 6px; min-height: 0; flex: 1; }
+#tray-list details { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); }
+#tray-list summary { padding: 7px 10px; font-size: 12.5px; font-weight: 700; cursor: pointer; }
+.tpl-tray-cap { padding: 4px 10px 2px; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); }
+.tpl-tray-item {
+    display: flex; justify-content: space-between; gap: 8px; width: calc(100% - 8px); margin: 0 4px 2px;
+    background: none; border: 0; color: var(--text); font: inherit; font-size: 12.5px; text-align: left;
+    padding: 5px 6px; border-radius: var(--radius-sm); cursor: pointer;
+}
+.tpl-tray-item:hover:not(:disabled) { background: var(--accent-soft); }
+.tpl-tray-item:disabled { color: var(--text-dim); cursor: default; }
+.tpl-tray-item:focus-visible { outline: 2px solid var(--accent); }
+.tpl-tray-tag { color: var(--text-dim); font-size: 11px; flex: none; }
+.tpl-tray-empty { color: var(--text-dim); font-size: 12.5px; padding: 8px 2px; }
+.tpl-tray-foot { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-dim); }
+.tpl-tray-foot input { width: 70px; padding: 0.3rem 0.5rem; font-size: 12.5px; }
+
+/* ---- 6. narrow + pop-out ---- */
+
+@media (max-width: 900px) {
+    .tpl-work { flex-direction: column; }
+    .tpl-tray { width: 100%; position: static; max-height: 60vh; }
+    .tpl-toolbar { position: static; }
+}
+.bd-narrow .bd-head { cursor: default; }
+
+/* A pop-out monitor window is just the board. */
+.tpl-window .rail, .tpl-window .page-topbar, .tpl-window .tpl-toolbar, .tpl-window .tpl-tray,
+.tpl-window #console-window, .tpl-window #console-fab { display: none !important; }
+.tpl-window.has-rail { padding-left: 0; }
+.tpl-window .content-area { padding: 12px; }
