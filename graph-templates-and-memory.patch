+    overflow: hidden;
+}
+.bd-block.is-dragging { z-index: 4; box-shadow: var(--shadow-pop); border-color: var(--accent); opacity: 0.94; }
+.bd-block[data-status="wired"] { border-style: dashed; }
+.bd-block[data-status^="missing"], .bd-block[data-status="unknown_class"] {
+    border-color: rgba(239, 68, 68, 0.5); background: rgba(239, 68, 68, 0.05);
+}
+
+.bd-head {
+    display: flex; align-items: center; gap: 8px; min-height: 30px; padding: 2px 6px 2px 10px;
+    border-bottom: 1px solid var(--border); background: var(--surface-alt); flex: none;
+}
+.bd-block.is-collapsed .bd-head { border-bottom: 0; height: 100%; }
+.bd-grip { display: none; color: var(--text-dim); letter-spacing: -2px; cursor: grab; user-select: none; }
+.bd-edit .bd-grip { display: inline; }
+.bd-edit .bd-head { cursor: grab; touch-action: none; }
+.bd-edit .bd-head:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
+.bd-titles { display: flex; flex-direction: column; min-width: 0; flex: 1; line-height: 1.2; }
+.bd-title { font-size: 13px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.bd-sub { font-size: 10.5px; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.bd-rename {
+    width: 100%; padding: 2px 6px !important; font-size: 13px !important; font-weight: 700;
+    border-radius: var(--radius-sm) !important;
+}
+.bd-badge {
+    font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
+    padding: 2px 7px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); flex: none;
+}
+.bd-badge[data-status^="missing"], .bd-badge[data-status="unknown_class"] {
+    background: rgba(239, 68, 68, 0.15); color: var(--red);
+}
+.bd-tools { display: flex; gap: 2px; flex: none; }
+.bd-tool {
+    background: none; border: 0; color: var(--text-dim); cursor: pointer; font: inherit;
+    width: 26px; height: 26px; border-radius: var(--radius-sm); line-height: 1;
+}
+.bd-tool:hover { background: var(--border); color: var(--text); }
+.bd-tool:focus-visible { outline: 2px solid var(--accent); }
+.bd-edit-only { display: none; }
+.bd-edit .bd-edit-only { display: inline-block; }
+.bd-block.is-collapsed [aria-label="Collapse / expand"] { transform: rotate(-90deg); }
+
+.bd-body { flex: 1; min-height: 0; padding: 8px 12px; overflow: auto; }
+.bd-resize {
+    display: none; position: absolute; right: 0; bottom: 0; width: 18px; height: 18px;
+    cursor: nwse-resize; touch-action: none;
+    background: linear-gradient(135deg, transparent 50%, var(--text-dim) 50%, var(--text-dim) 58%, transparent 58%, transparent 72%, var(--text-dim) 72%, var(--text-dim) 80%, transparent 80%);
+    opacity: 0.7;
+}
+.bd-edit .bd-resize { display: block; }
+.bd-edit .bd-block.is-collapsed .bd-resize { display: none; }
+.bd-edit .bd-block { border-style: dashed; }
+.bd-edit .bd-block:hover { border-color: var(--accent); }
+
+/* ---- 4. block contents ---- */
+
+.bd-field { display: flex; flex-direction: column; gap: 6px; }
+.bd-field .cfg-input, .bd-field select { padding: 0.45rem 0.6rem; font-size: 13.5px; }
+.bd-field.is-inactive .bd-control { opacity: 0.45; }
+.bd-hint { font-size: 11.5px; color: var(--text-dim); }
+.bd-bool { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer; }
+.bd-bool input[type="checkbox"], .bd-auto input[type="checkbox"] { width: 1.25rem; height: 1.25rem; flex: none; }
+.bd-auto { display: flex; align-items: center; gap: 8px; }
