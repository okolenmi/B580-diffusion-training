+++ b/frontend/templates.html
@@ -0,0 +1,106 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Templates</title>
+    <link rel="icon" href="data:,">
+    <link rel="stylesheet" href="/ui/css/style.css">
+    <link rel="stylesheet" href="/ui/css/shell.css">
+    <link rel="stylesheet" href="/ui/css/templates.css">
+</head>
+<body class="layout-fixed tpl-body">
+    <main class="content-area" id="tpl-main">
+        <header class="page-topbar">
+            <a class="btn btn-secondary btn-small" id="btn-back" href="/templates" hidden>&larr; Templates</a>
+            <h1 id="tpl-title">Templates</h1>
+            <span class="page-sub" id="tpl-sub">Ready-made pages and monitor windows built on your graphs</span>
+        </header>
+
+        <!-- ================= LIST VIEW ================= -->
+        <div class="page-body" id="view-list">
+            <section class="card" id="new-card">
+                <div class="card-header"><span>New from a graph</span></div>
+                <div class="tpl-new">
+                    <label class="tpl-field">
+                        <span>Kind</span>
+                        <select id="new-kind" aria-label="Kind">
+                            <option value="template">Page &mdash; edit values and run</option>
+                            <option value="monitor">Monitor window &mdash; watch a run</option>
+                        </select>
+                    </label>
+                    <label class="tpl-field">
+                        <span>Graph</span>
+                        <select id="new-graph" aria-label="Saved graph"></select>
+                    </label>
